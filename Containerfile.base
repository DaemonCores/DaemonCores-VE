#####################################################################################
# Shared base for the DaemonCores VE images
#####################################################################################
# The shared image pipeline (DaemonCores-CI/.github/workflows/bootc-build.yml)
# builds this manifest once per build job as localhost/debian-bootc-base and
# passes it to every product Containerfile as BASE_IMAGE. It is never pushed.
#
# Unlike debian-bootc's Containerfile.base (which assembles a Debian root from
# scratch), VE derives from the PUBLISHED debian-bootc base image: the bootc
# toolchain, kernel, ostree migration and initramfs come from it, and the
# product Containerfile only layers the Proxmox packages from the VE APT
# repository.
#
# The FROM line feeds the image content hash (the base digest is part of the
# identity), so a newer published base invalidates the cached image. The tag
# is arch-suffixed on purpose: `latest` resolves to a single-amd64 manifest
# (ghcr.io, measured 2026-11-03: latest == latest_amd64), so an arm64 base
# build FROM :latest pulled amd64 content and died with "exec format error"
# at the first RUN (run 41611788184). The builder passes ARCH per arch job;
# the amd64 default keeps plain local builds working.
ARG ARCH=amd64
# hadolint ignore=DL3007
FROM ghcr.io/daemoncores/debian-bootc:latest_${ARCH}
# Auto-derivation of the repository of THIS repo (template pattern,
# Containerfile.base:33-52): the pipeline derives both values from the
# APT_GPG_KEY secret on every run (full-pipeline.yml apt_key job, passed by
# bootc-build.yml as env BOOTC_GPG_SHA256 / APT_URL -> build-arg
# BOOTC_APT_URL). Empty args mean "repository not configured": plain local
# builds of the base stay inert, and nothing is committed after a key
# rotation. Only the keyring is provisioned here: the sources stanza is owned
# by the product Containerfile (src/pvepreinstall ships daemoncores-ve.sources
# with the matching Signed-By path), so the repository is never declared twice.
ARG BOOTC_APT_URL=""
ARG BOOTC_GPG_SHA256=""
# hadolint ignore=DL4006
RUN if [ -n "${BOOTC_APT_URL}" ] && [ -n "${BOOTC_GPG_SHA256}" ]; then \
        url="${BOOTC_APT_URL%/}"; \
        wget -nv -O /usr/share/keyrings/daemoncores-ve-keyring.gpg "${url}/gpg.key" \
        && printf '%s  /usr/share/keyrings/daemoncores-ve-keyring.gpg\n' "${BOOTC_GPG_SHA256}" \
            | sha256sum -c -; \
    fi
STOPSIGNAL SIGRTMIN+3
ENV DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-euo", "pipefail", "-c"]