# Thin `-thpnever-<flavour>` twin of the main DaemonCores VE image.
#
# Owner arbitration (2026-11-03 13:05, supersedes the 12:14/12:55 THP lane):
# the DEFAULT image profile is THP=ALWAYS (the kernel pin lives in the
# shared kconfig fragment, full-LXC prime: every CT allocation is served in
# 2M/1G hugepages). The THP=never profile is the DERIVED choice: this twin
# carries it for one kernel flavour (x64v1..v4, armv8.x/9) as a thin layer
# on the SAME image content — same PVE kernel and debs, NO second kernel
# build. The profile travels with the image (bootc-finalize doctrine,
# P-513a/470): it installs as an install-time variable, applies at install,
# reinstalls and bootc updates.
#
# Two carriers, one profile:
#  - a bootc kargs.d entry (karg transparent_hugepage=never — the boot arg
#    applies before any userspace allocation);
#  - a systemd-tmpfiles `w!` rule writing `never` into
#    /sys/kernel/mm/transparent_hugepage/enabled on every boot (belt for
#    boots where the karg is not delivered);
#  and the /usr/share/dc-ve-thp-profile marker (`never`) for the boot-time
#  proof: the boot test asserts the sysfs THP state against the marker
#  (default [always], twin [never]).
#
ARG BASE_IMAGE=ghcr.io/daemoncores/daemoncores-ve:latest_${ARCH}
FROM ${BASE_IMAGE}
STOPSIGNAL SIGRTMIN+3

LABEL org.opencontainers.image.title="DaemonCores VE (THP never, x64v2)"
LABEL org.opencontainers.image.description="THP NEVER twin of the x64v2 (x86-64-v2) flavour. The hugepage decision belongs to the GUEST (PVE memory: hugepages 2M/1G per VM/CT, per-VM/CT tuning); the default image keeps THP=always (full-LXC prime). Same kernel and debs as the default image — no second kernel build."
LABEL org.daemoncores.arches="amd64"
LABEL org.daemoncores.twin="latest"
LABEL org.daemoncores.flavour="x64v2"

RUN mkdir -p /usr/lib/bootc/kargs.d /usr/lib/tmpfiles.d /usr/share \
    && printf '[kargs]\n"transparent_hugepage" = ["never"]\n' \
        > /usr/lib/bootc/kargs.d/90-dc-thp-never.toml \
    && printf 'w! /sys/kernel/mm/transparent_hugepage/enabled - - - - never\n' \
        > /usr/lib/tmpfiles.d/dc-thp-never.conf \
    && printf 'never\n' > /usr/share/dc-ve-thp-profile