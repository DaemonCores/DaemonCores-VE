# Thin `-thpalways` twin of the fork main image (ruling R-804).
#
# The vanilla proxmox-ve-bootc images boot THP=never: the karg
# transparent_hugepage=never sits in their kargs.d, on the ONE compiled
# kernel (the shared fragment's ALWAYS pin). The fork full image inherits
# it, so its profile is [never]. This twin derives the ALWAYS profile from
# that exact image — same kernel and debs, NO second kernel build, ONE thin
# layer: the vanilla karg file is removed so the compiled ALWAYS default
# applies (the x86-64-v4 microarch flavour). The boot test reads the /usr/share/dc-ve-thp-profile marker
# (full image never / twin always).
ARG BASE_IMAGE=ghcr.io/daemoncores/daemoncores-ve:latest_${ARCH}
FROM ${BASE_IMAGE}
STOPSIGNAL SIGRTMIN+3

LABEL org.opencontainers.image.title="DaemonCores VE (THP always, x64v4)"
LABEL org.opencontainers.image.description="Thin ALWAYS twin of the fork image — same kernel and debs, the THP karg alone is flipped (ruling R-804: both profiles available, no kernel rebuild)."
LABEL org.daemoncores.arches="amd64"
LABEL org.daemoncores.twin="latest"
LABEL org.daemoncores.flavour="x64v4"

RUN rm -f /usr/lib/bootc/kargs.d/20-thp-never.toml     && mkdir -p /usr/share     && printf 'always\n' > /usr/share/dc-ve-thp-profile
