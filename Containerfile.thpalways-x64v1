# Thin `-thpalways` twin of the vanilla never image (ruling R-804).
#
# The vanilla proxmox-ve-bootc images boot THP=never (the karg
# transparent_hugepage=never rides in their kargs.d on the ONE compiled
# kernel). This fork twin derives the ALWAYS profile from that exact image:
# same kernel and debs, NO second kernel build, the karg file alone is
# removed so the compiled ALWAYS default applies (the x86-64-v1 microarch flavour).
ARG BASE_IMAGE=ghcr.io/daemoncores/proxmox-ve-bootc:latest_x64v1
FROM ${BASE_IMAGE}
STOPSIGNAL SIGRTMIN+3

LABEL org.opencontainers.image.title="Proxmox VE bootc (THP always, x64v1)"
LABEL org.opencontainers.image.description="Thin ALWAYS twin of the proxmox-ve-bootc never image — same kernel and debs, the THP karg alone is flipped. Ships by the DaemonCores-VE fork (ruling R-804: both profiles available, no kernel rebuild)."
LABEL org.daemoncores.flavour="x64v1"

RUN rm -f /usr/lib/bootc/kargs.d/20-thp-never.toml     && mkdir -p /usr/share     && printf 'always\n' > /usr/share/dc-ve-thp-profile
