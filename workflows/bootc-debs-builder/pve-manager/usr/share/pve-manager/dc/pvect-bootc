#!/bin/bash
#
# pvect-bootc - bootc guest lifecycle for the variant A guest type
#   (docs/compose-variant-a-plan.md, surface S7/S8). Thin delegate shell:
#   the image/template machinery stays in pvect-ostree and the seed payload
#   in the OstreeComposefsPlugin; this wrapper only owns the guest-facing
#   verbs and the per-guest conf (nodes/<node>/bootc/<vmid>.conf on the
#   cluster fs, status line carried round-trip).
#
#   pvect-bootc create  <vmid> <archive> [--name N] [--description D] [--onboot 0|1]
#                       [--net0 'name=eth0,bridge=vmbr0,ip=CIDR,gw=G'] [--net1 ...] [--net2 ...]
#   pvect-bootc publish  <compose.yml> [--name N]   # build + smoke + publish
#   pvect-bootc templates                            # seed templates (TSV)
#   pvect-bootc compose-read <stack>                 # recorded compose source
#   pvect-bootc start   <vmid>
#   pvect-bootc stop    <vmid>      # hard
#   pvect-bootc shutdown <vmid>     # graceful
#   pvect-bootc status  <vmid>
#   pvect-bootc destroy <vmid>
#   pvect-bootc refresh <vmid>
set -uo pipefail

# Source-safe: a caller (tests) may export PROG — and a readonly PROG must
# not fault the re-assignment — so only set it when actually unset/empty.
if [[ -z ${PROG:-} ]]; then PROG=$(basename "$0"); fi
VOSTREE="pvect-ostree"

ETC=$'/etc/pve'
COMPOSE_DIR=/var/lib/pvect-ostree/compose
# Unprivileged id-map of the guest runtime: the same pair pvect-ostree deploys
# with (its CONF wins, the PVE default is the fallback).
UID_BASE=$(awk -F= '$1 == "UID_BASE" {print $2; exit}' /etc/pvect-ostree/pvect-ostree.conf 2>/dev/null)
UID_BASE=${UID_BASE:-100000}
UID_RANGE=$(awk -F= '$1 == "UID_RANGE" {print $2; exit}' /etc/pvect-ostree/pvect-ostree.conf 2>/dev/null)
UID_RANGE=${UID_RANGE:-65536}
# PVE storage for the seed templates. Empty (default): the vztmpl-capable
# storage that ALREADY holds templates wins (pveam listing), else the FIRST
# active storage with 'content vztmpl' in /etc/pve/storage.cfg — never a
# hard-coded storeid. An explicit value (env/CONF) always wins, so the
# variables are only defaulted, never reset.
TEMPLATE_STORAGE=${TEMPLATE_STORAGE:-}
STORAGE_CFG=${PVECT_STORAGE_CFG:-/etc/pve/storage.cfg}
# PVE storage holding the guest rootfs volume (directory tree). Resolved like
# pvect-ostree does — explicit env/CONF wins, else the first active storage
# with 'content rootdir' — never the template's storeid by assumption.
ROOTFS_STORAGE=${ROOTFS_STORAGE:-}
if [[ -z $ROOTFS_STORAGE && -r /etc/pvect-ostree/pvect-ostree.conf ]]; then
  ROOTFS_STORAGE=$(awk -F= '$1 == "ROOTFS_STORAGE" {print $2; exit}' /etc/pvect-ostree/pvect-ostree.conf 2>/dev/null)
fi

#######################################
# Print the storage ids whose /etc/pve/storage.cfg stanza declares
# 'content <type>', in declaration order. No invented names.
# Arguments:
#   $1 - content type (vztmpl, ...)
#######################################
storage_ids_with_content() {
  local want=$1
  awk -v w="$want" '
    /^[[:space:]]*(#|$)/ { next }
    /^[^[:space:]]/ {
      # Stanza line "type: <storeid>": the first colon delimits the plugin
      # type, the storeid runs until the next whitespace.
      sid = $0
      sub(/^[^:]*:[[:space:]]*/, "", sid)
      sub(/[[:space:]].*$/, "", sid)
      if (sid == "") { next }
      if (!(sid in seen)) { seen[sid] = 1; order[++n] = sid }
      cur = sid
      next
    }
    $1 == "content" {
      # Both PVE spellings parse: "content rootdir,images" (comma-separated)
      # and "content rootdir images" (whitespace) — normalise to a comma list.
      line = $0
      sub(/^[[:space:]]*content[[:space:]]+/, "", line)
      gsub(/[[:space:],]+/, ",", line)
      content[cur] = content[cur] "," line
    }
    END {
      for (i = 1; i <= n; i++)
        if (index("," content[order[i]] ",", "," w) > 0) print order[i]
    }
  ' "$STORAGE_CFG"
}

#######################################
# Print the first declared storage with 'content <type>' that pvesm reports
# active for that content type; exit 1 when none is usable.
# Arguments:
#   $1 - content type (vztmpl, ...)
#######################################
first_active_storage() {
  local want=$1 sid active
  active=$(pvesm status -content "$want" 2>/dev/null \
    | awk '$3 == "active" {print $1}')
  for sid in $(storage_ids_with_content "$want"); do
    if grep -qxF "$sid" <<<"$active"; then
      echo "$sid"
      return 0
    fi
  done
  return 1
}

#######################################
# Fill in TEMPLATE_STORAGE when left empty: existing-templates-then-first
# vztmpl-capable storage, resolved from the node's own storage configuration.
#######################################
resolve_default_storages() {
  if [[ -n $TEMPLATE_STORAGE ]]; then
    return 0
  fi
  local sid
  for sid in $(storage_ids_with_content vztmpl); do
    if pveam list "$sid" 2>/dev/null | grep -q .; then
      TEMPLATE_STORAGE=$sid
      return 0
    fi
  done
  TEMPLATE_STORAGE=$(first_active_storage vztmpl) || TEMPLATE_STORAGE=
  if [[ -z $ROOTFS_STORAGE ]]; then
    ROOTFS_STORAGE=$(first_active_storage rootdir) || ROOTFS_STORAGE=
  fi
}

info() { echo "$PROG: $*" >&2; }
warn() { command -v logger >/dev/null 2>&1 && logger -t "$PROG" "$*" 2>/dev/null; echo "$PROG: warning: $*" >&2; }
die() {
  warn "$*"
  exit 1
}

need_root() { [[ $(id -u) -eq 0 ]] || die "must run as root"; }

nodename() { cat /etc/hostname 2>/dev/null || hostname; }

conf_path() { echo "$ETC/nodes/$(nodename)/bootc/$1.conf"; }

#######################################
# Rewrite the per-guest conf with an updated key, keeping the other lines.
# Arguments:
#   $1 - vmid; $2 - key; $3 - new value; $4 - keep absent when empty (0/1)
#######################################
conf_set() {
  local vmid=$1 key=$2 value=$3 f
  f=$(conf_path "$vmid")
  [[ -f $f ]] || die "no bootc conf for guest $vmid at $f"
  if [[ -n $value ]]; then
    if grep -qE "^${key}:" "$f" 2>/dev/null; then
      sed -i -E "s|^(${key}):.*$|\1: $value|" "$f"
    else
      printf '%s: %s\n' "$key" "$value" >>"$f"
    fi
  else
    sed -i -E "/^${key}:.*$/d" "$f"
  fi
}

conf_get() {
  local f
  f=$(conf_path "$1")
  [[ -r $f ]] || return 0
  awk -F': ' -v k="$2" '$1 == k {print $2; exit}' "$f" 2>/dev/null
}

is_mounted() {
  local sub
  sub=$("$VOSTREE" subvol-path "$1" 2>/dev/null) || return 1
  # composefs view check: the .ostree.cfs marker lives inside the mounted view
  [[ -f "$sub/.ostree.cfs" && -d "$sub/var/lib" ]] 2>/dev/null
}

#######################################
# Build + smoke + publish a compose stack as a seed template (delegate to
# pvect-ostree publish; stdout stays reserved for the image reference so the
# caller can chain it).
# Arguments:
#   $1 - compose file; $@ - extra args (--name N)
#######################################
publish_stack() {
  local compose=$1
  shift
  need_root
  [[ -r $compose ]] || die "compose file not found: $compose"
  "$VOSTREE" publish "$compose" "$@" || die "seed template publish failed"
  info "compose stack published (template $TEMPLATE_STORAGE:vztmpl/<stack>.tar.gz)"
}

#######################################
# List the published seed templates as TSV (archive, stack, imgref, epoch,
# compose path) - the shape the bootc REST API forwards to the UI.
#######################################
list_templates() {
  need_root
  [[ -n $TEMPLATE_STORAGE ]] \
    || die "no storage with 'content vztmpl' found in $STORAGE_CFG (set TEMPLATE_STORAGE)"
  local f stack imgref compose ctime archive
  shopt -s nullglob
  for f in "$COMPOSE_DIR"/*/*.payload.env; do
    stack=""; imgref=""; compose=""
    # shellcheck source=/dev/null
    . "$f"
    # shellcheck disable=SC2153
    ctime=$(stat -c '%Y' "$f")
    archive="$TEMPLATE_STORAGE:vztmpl/$STACK.tar.gz"
    printf '%s\t%s\t%s\t%s\t%s\n' "$archive" "$STACK" "$IMGREF" "$ctime" "$COMPOSE"
  done
}

#######################################
# Print the compose source recorded for a published stack.
# Arguments:
#   $1 - stack name
#######################################
read_stack_compose() {
  local stack=$1 envf compose
  need_root
  envf="$COMPOSE_DIR/$stack/$stack.payload.env"
  [[ -r $envf ]] || die "no published stack '$stack'"
  compose=$(grep -m1 '^COMPOSE=' "$envf" | cut -d= -f2-)
  [[ -n $compose && -r $compose ]] || die "stack $stack has no recorded compose source"
  cat "$compose"
}

#######################################
# Print the volume id a storeid accepts for a fresh subvol: dir-like storages
# namespace their volumes under <vmid>/, btrfs-style ones do not. Resolved by
# asking pvesm, never by assuming a layout.
# Arguments:
#   $1 - storeid; $2 - vmid; $3 - bare volume name
# Outputs:
#   The working volid on stdout; exit 1 when neither form resolves.
#######################################
resolve_volid() {
  local store=$1 vmid=$2 name=$3 cand path
  for cand in "$vmid/$name" "$name"; do
    path=$(pvesm path "$store:$cand" 2>/dev/null) || continue
    # pvesm path prints the would-be location even for a volume that does not
    # exist yet: only an existing tree counts as resolved (otherwise no
    # allocation would ever happen).
    [[ -n $path && -e $path ]] || continue
    echo "$store:$cand"
    return 0
  done
  return 1
}

guest_exists() {
  [[ -f $(conf_path "$1") ]]
}

require_guest() { guest_exists "$1" || die "guest $1 is not managed by pvect-bootc"; }

#######################################
# Create a bootc guest from a published seed template.
# Allocates the rootdir volume on the plugin storage, extracts the seed,
# adopts and mounts it; then opens the guest's cluster conf.
# Globals:
#   TEMPLATE_STORAGE
# Arguments:
#   $1 - vmid; $2 - archive ($TEMPLATE_STORAGE:vztmpl/<stack>.tar.gz); $@ - options
#######################################
create_guest() {
  local vmid=$1 archive=$2
  need_root
  guest_exists "$vmid" && die "guest $vmid already exists"
  # pct semantics: one veth on the default bridge with DHCP unless the caller
  # says otherwise (the value is written into the conf, editable afterwards).
  [[ -n $NET0 || -n $NET1 || -n $NET2 ]] || NET0="name=eth0,bridge=vmbr0,ip=dhcp"

  local storeid stack file
  storeid=${archive%%:*}
  [[ -n $storeid && $archive == *':vztmpl/'* ]] || die "invalid archive '$archive' (expected $TEMPLATE_STORAGE:vztmpl/<stack>.tar.gz)"
  stack=${archive#*:vztmpl/}; stack=${stack%.tar.gz}
  # Resolve the seed file location through the storage API — the vztmpl dir
  # and backing path depend on the resolved storage's own configuration.
  file=$(pvesm path "$storeid:vztmpl/$stack.tar.gz" 2>/dev/null)
  [[ -n $file && -r $file ]] \
    || die "seed template $archive not found (resolved storage: ${TEMPLATE_STORAGE:-none})"

  # allocate the rootdir volume on the resolved rootfs storage (a directory
  # tree; the composefs view is mounted onto it at start)
  local volname volid subvol volstore
  volstore=${ROOTFS_STORAGE:-$storeid}
  [[ -n $volstore ]] || die "no storage with 'content rootdir' found (set ROOTFS_STORAGE)"
  volname="subvol-${vmid}-disk-0.subvol"
  volid=$(resolve_volid "$volstore" "$vmid" "$volname") || {
    # pin the subvol format — btrfs/dir storages default to raw, which pvesm
    # then refuses for a 'subvol-*' name; storages without subvol quotas
    # refuse a sized subvolume, so an unsized one (size 0) is the fallback.
    if ! pvesm alloc "$volstore" "$vmid" "$volname" 32212254720 --format subvol >/dev/null 2>&1; then
      pvesm alloc "$volstore" "$vmid" "$volname" 0 --format subvol >/dev/null \
        || die "volume allocation failed on $volstore"
      warn "rootfs volume allocated unsized on $volstore (no size quota)"
    fi
    volid=$(resolve_volid "$volstore" "$vmid" "$volname") \
      || die "cannot resolve the allocated volume on $volstore"
  }
  subvol=$(pvesm path "$volid") || die "cannot resolve the allocated volume"

  # seed content (the payload is hidden/wiped at first activation by the
  # existing machinery)
  tar -xzf "$file" -C "$subvol" || die "seed extraction failed"
  local payload="$subvol/pvect-ostree/payload.env"
  [[ -r $payload ]] || die "seed payload missing after extraction"

  local compose=""
  [[ -r $payload ]] && compose=$(grep -m1 '^COMPOSE=' "$payload" | cut -d= -f2-)

  # register with the ostree machinery (deployment into the volume's sysroot,
  # writable layers under <volume>/pvect-ostree/layers, composefs view mounted)
  "$VOSTREE" guest-adopt "$vmid" "$subvol" || die "pvect-ostree guest-adopt failed"

  # open the guest conf on the cluster fs (the directory PVE::Bootc lists;
  # pmxcfs has no guest-type scanner for it, so the API reads the directory)
  local f confdir confdir_owner
  confdir=$(dirname "$(conf_path "$vmid")")
  mkdir -p "$confdir" || die "cannot create $confdir"
  confdir_owner=$(stat -c '%u:%g' "$confdir")
  f=$(conf_path "$vmid")
  {
    printf 'name: %s\n' "${NAME:-bootc-$vmid}"
    [[ -n $DESC ]] && printf 'description: %s\n' "$DESC"
    printf 'onboot: %s\n' "${ONBOOT:-0}"
    printf 'archive: %s\n' "$archive"
    printf 'stack: %s\n' "$stack"
    printf 'volname: %s\n' "$volid"
    printf 'compose: %s\n' "$compose"
    printf 'status: stopped\n'
    # network stanzas, pct key names; hwaddr is pinned once here so the guest
    # keeps its MAC across restarts
    local idx key
    for idx in 0 1 2; do
      eval "key=\${NET$idx:-}"
      [[ -n $key ]] || continue
      [[ $key == *hwaddr=* ]] || key="$key,hwaddr=$(gen_hwaddr)"
      printf 'net%s: %s\n' "$idx" "$key"
    done
  } >"$f"
  # pmxcfs creates files owned by the node's config owner; keep it explicit.
  chown "$confdir_owner" "$f" 2>/dev/null || true
  [[ -f $f ]] || die "conf creation failed"
  info "bootc guest $vmid created (stack $stack, template $stack.tar.gz)"
}

#######################################
# Bootc guest runtime: the guest is a real LXC container (systemd as PID1),
# started from a config generated here — no /etc/pve/lxc conf, so it stays a
# `bootc` guest for PVE. The composefs view and the writable layers come from
# pvect-ostree (guest-adopt/guest-mount), which is the validated deployment
# machinery; this file owns the runtime around it.
#######################################

# Per-guest runtime state (generated LXC config + logs). Never host state that
# matters: the config is regenerated on every start from the guest conf.
GUEST_STATE=/var/lib/pvect-ostree/guests

guest_dir() { echo "$GUEST_STATE/$1"; }
lxc_name() { echo "bootc-$1"; }

guest_rootfs() {
  local vol path vmid=$1
  vol=$(conf_get "$1" volname)
  vol=${vol%%,*}
  [[ -n $vol ]] || die "guest $1 has no volume (volname key missing)"
  path=$(pvesm path "$vol" 2>/dev/null) || path=
  if [[ -z $path ]]; then
    # dir-like storages namespace their volumes under <vmid>/: retry that form
    # when the conf carries the bare volume name.
    path=$(pvesm path "${vol%%:*}:$vmid/${vol#*:}" 2>/dev/null) || path=
  fi
  [[ -n $path ]] || die "cannot resolve the volume of guest $vmid ($vol)"
  echo "$path"
}

lxc_running() {
  lxc-info -n "$(lxc_name "$1")" -sH 2>/dev/null | grep -q RUNNING
}

#######################################
# Parse one pct-style network string (name=eth0,bridge=vmbr0,ip=...,gw=...)
# into NET_* globals. Keys are the pct ones; unknown keys are ignored so a
# value copied from a pct conf parses.
# Arguments:
#   $1 - the network string
#######################################
net_parse() {
  NET_NAME=""; NET_BRIDGE=""; NET_IP=""; NET_GW=""; NET_HWADDR=""; NET_MTU=""
  local kv
  local IFS=','
  for kv in $1; do
    case ${kv%%=*} in
      name) NET_NAME=${kv#*=} ;;
      bridge) NET_BRIDGE=${kv#*=} ;;
      ip) NET_IP=${kv#*=} ;;
      gw) NET_GW=${kv#*=} ;;
      gw6) NET_GW6=${kv#*=} ;;
      hwaddr) NET_HWADDR=${kv#*=} ;;
      mtu) NET_MTU=${kv#*=} ;;
    esac
  done
  NET_NAME=${NET_NAME:-eth0}
}

#######################################
# Print a stable PVE-style MAC address for a guest interface (BC:24:11 prefix,
# randomised once and then kept in the guest conf).
#######################################
gen_hwaddr() {
  printf 'BC:24:11:%02X:%02X:%02X' $((RANDOM % 256)) $((RANDOM % 256)) $((RANDOM % 256))
}

#######################################
# Prepare the LXC view of a bootc guest, host-side. LXC performs its mount
# entries from inside the container's user namespace, and the composefs view is
# owned by pvect-ostree's own namespace (idmap=): every bind/tmpfs entry then
# fails with EACCES. Mounting them here, in the initial namespace, before
# lxc-start leaves a rootfs LXC only has to use.
# Arguments:
#   $1 - vmid; $2 - view path; $3 - layer directory
#######################################
prepare_view() {
  local vmid=$1 view=$2 layers=$3 dir
  # volatile dirs of the read-only image
  for dir in run tmp; do
    if ! mountpoint -q "$view/$dir"; then
      mount -t tmpfs -o rw,nosuid,nodev tmpfs "$view/$dir" \
        || die "cannot mount tmpfs on $view/$dir for guest $vmid"
    fi
  done
  # writable layers
  for dir in etc var; do
    if ! mountpoint -q "$view/$dir"; then
      mount --bind "$layers/$dir" "$view/$dir" \
        || die "cannot bind $layers/$dir into the view of guest $vmid"
    fi
  done
  if [[ -d $layers/bootc && ! -d $view/usr/lib/bootc ]]; then
    mkdir -p "$view/usr/lib/bootc" 2>/dev/null || true
  fi
  if [[ -d $layers/bootc ]] && ! mountpoint -q "$view/usr/lib/bootc"; then
    mount --bind "$layers/bootc" "$view/usr/lib/bootc" 2>/dev/null \
      || warn "bootc shadow not bindable for guest $vmid (nested image store absent)"
  fi
  # host-only apparmor parameter: mask it so apparmor.service skips itself
  if [[ -e $view/sys/module/apparmor/parameters/enabled ]]; then
    mount --bind /dev/null "$view/sys/module/apparmor/parameters/enabled" 2>/dev/null || true
  fi
  for dir in /dev/fuse /dev/net/tun; do
    [[ -e $view$dir ]] || continue
    mountpoint -q "$view$dir" || mount --bind "$dir" "$view$dir" 2>/dev/null || true
  done
  # stack data lives on the host at /var/lib/compose2bootc/<stack>: bind the
  # stack's own directory in when it exists (quadlet volumes point there).
  local stack
  stack=$(conf_get "$vmid" stack)
  if [[ -n $stack && -d /var/lib/compose2bootc/$stack ]]; then
    mkdir -p "$view/var/lib/compose2bootc/$stack" 2>/dev/null || true
    mountpoint -q "$view/var/lib/compose2bootc/$stack" \
      || mount --bind "/var/lib/compose2bootc/$stack" "$view/var/lib/compose2bootc/$stack" \
        || warn "stack data not bindable for guest $vmid"
  fi
}

#######################################
# Generate the LXC config of a bootc guest from its conf (rootfs view, the
# writable layers as binds, and the net0/net1/net2 stanzas).
# Arguments:
#   $1 - vmid
#######################################
gen_lxc_conf() {
  local vmid=$1 root base layers conf net idx
  root=$(guest_rootfs "$vmid")
  [[ -d $root ]] || die "guest $vmid rootfs volume is not resolved (volname in the conf)"
  # pvect-ostree keeps the guest state (image, digest store, writable layers)
  # in a sibling directory of the volume: the volume root is covered by the
  # composefs mount.
  base="$(dirname "$root")/bootc-$vmid"
  layers="$base/layers"
  # LXC cannot open the idmapped composefs mount directly (the mount belongs to
  # pvect-ostree's user namespace); a plain bind mount of the view is opened by
  # the initial namespace and works.
  local view
  view="$(guest_dir "$vmid")/rootfs"
  mkdir -p "$(guest_dir "$vmid")" "$view"
  if ! mountpoint -q "$view"; then
    mount --bind "$root" "$view" || die "cannot bind-mount the composefs view for $vmid"
  fi
  prepare_view "$vmid" "$view" "$layers"
  conf="$(guest_dir "$vmid")/lxc.conf"
  {
    echo "# generated by $PROG start $vmid -- regenerated on every start"
    echo "lxc.include = /usr/share/lxc/config/common.conf"
    echo "lxc.include = /usr/share/lxc/config/userns.conf"
    echo "lxc.arch = amd64"
    echo "lxc.uts.name = $(lxc_name "$vmid")"
    echo "lxc.apparmor.profile = unconfined"
    echo "lxc.mount.auto = proc:mixed sys:ro"
    echo "lxc.idmap = u 0 $UID_BASE $UID_RANGE"
    echo "lxc.idmap = g 0 $UID_BASE $UID_RANGE"
    echo "lxc.tty.max = 2"
    echo "lxc.rootfs.path = dir:$view"
    # No lxc.mount.entry: every bind/tmpfs is set up host-side by prepare_view
    # (LXC cannot mount onto the idmapped composefs view from its own userns).
    for idx in 0 1 2; do
      net=$(conf_get "$vmid" "net$idx")
      [[ -n $net ]] || continue
      net_parse "$net"
      echo "lxc.net.$idx.type = veth"
      echo "lxc.net.$idx.name = $NET_NAME"
      [[ -n $NET_BRIDGE ]] && echo "lxc.net.$idx.link = $NET_BRIDGE"
      echo "lxc.net.$idx.flags = up"
      [[ -n $NET_HWADDR ]] && echo "lxc.net.$idx.hwaddr = $NET_HWADDR"
      [[ -n $NET_MTU ]] && echo "lxc.net.$idx.mtu = $NET_MTU"
      # static addressing is applied by LXC itself inside the container's
      # network namespace (the pct ip=/gw= semantics); ip=dhcp leaves the
      # interface up and lets the guest's own client obtain a lease.
      if [[ -n $NET_IP && $NET_IP != dhcp ]]; then
        echo "lxc.net.$idx.ipv4.address = $NET_IP"
        [[ -n $NET_GW ]] && echo "lxc.net.$idx.ipv4.gateway = $NET_GW"
      fi
      [[ -n ${NET_GW6:-} ]] && echo "lxc.net.$idx.ipv6.gateway = $NET_GW6"
    done
  } >"$conf"
  echo "$conf"
}

start_guest() {
  local vmid=$1 root conf
  require_guest "$vmid"
  lxc_running "$vmid" && die "guest $vmid is already running"
  command -v lxc-start >/dev/null 2>&1 || die "lxc-start not found (lxc-pve missing)"
  root=$(guest_rootfs "$vmid")
  [[ -n $root ]] || die "cannot resolve the rootfs volume of guest $vmid"

  # composefs view + writable layers (pvect-ostree owns the deployment)
  "$VOSTREE" guest-mount "$vmid" "$root" || die "rootfs mount failed for $vmid"

  conf=$(gen_lxc_conf "$vmid") || die "LXC config generation failed for $vmid"
  lxc-start -n "$(lxc_name "$vmid")" -f "$conf" \
    --logfile "$(guest_dir "$vmid")/lxc.log" --logpriority INFO \
    || die "lxc-start failed for $vmid (see $(guest_dir "$vmid")/lxc.log)"
  if ! lxc-wait -n "$(lxc_name "$vmid")" -s RUNNING -t 60; then
    warn "guest $vmid did not reach RUNNING within 60s"
  fi
  # systemd must be the real init, not a bare shell in a mounted view
  local init
  init=$(lxc-info -n "$(lxc_name "$vmid")" -p 2>/dev/null | awk '{print $NF}')
  conf_set "$vmid" status running
  info "bootc guest $vmid started (lxc $(lxc_name "$vmid"), init pid ${init:-?})"
}

stop_common() {
  local vmid=$1 hard=${2:-1} root
  require_guest "$vmid"
  if lxc_running "$vmid"; then
    if [[ $hard -eq 1 ]]; then
      lxc-stop -n "$(lxc_name "$vmid")" -k --timeout 10 2>/dev/null \
        || warn "lxc-stop -k failed for guest $vmid"
    else
      lxc-stop -n "$(lxc_name "$vmid")" --timeout 10 2>/dev/null \
        || warn "lxc-stop failed for guest $vmid"
    fi
    lxc-wait -n "$(lxc_name "$vmid")" -s STOPPED -t 30 2>/dev/null || true
  fi
  # A container that did not actually stop still holds the mounts: tearing the
  # rootfs down under it left a read-only composefs view behind and the volume
  # free then failed on every path. Keep the mounts while it lives.
  if lxc_running "$vmid"; then
    warn "guest $vmid is still running; rootfs mounts kept"
    return 1
  fi
  root=$(guest_rootfs "$vmid" 2>/dev/null) || root=""
  local view
  view="$(guest_dir "$vmid")/rootfs"
  if mountpoint -q "$view"; then
    umount -R "$view" 2>/dev/null || umount -l -R "$view" 2>/dev/null \
      || warn "could not release the guest view mounts of $vmid"
  fi
  if [[ -n $root && -d $root ]]; then
    if mountpoint -q "$root"; then
      "$VOSTREE" guest-umount "$vmid" "$root" || warn "rootfs unmount failed for $vmid"
    fi
    if mountpoint -q "$root"; then
      umount -l "$root" 2>/dev/null || warn "composefs view of $vmid still mounted"
    fi
  fi
  conf_set "$vmid" status stopped
}

shutdown_guest() {
  local vmid=$1 timeout=${SHUTDOWN_TIMEOUT:-30} start
  require_guest "$vmid"
  start=$(date +%s)
  if lxc_running "$vmid"; then
    # graceful: ask the guest's own systemd to power off, then wait
    lxc-attach -n "$(lxc_name "$vmid")" -- systemctl poweroff 2>/dev/null \
      || warn "could not signal systemd in guest $vmid; falling back to lxc-stop"
    if ! lxc-wait -n "$(lxc_name "$vmid")" -s STOPPED -t "$timeout"; then
      warn "guest $vmid still running after ${timeout}s; hard stop"
    fi
  fi
  stop_common "$vmid" 1
  info "bootc guest $vmid shut down ($(($(date +%s) - start))s)"
}

stop_guest() { stop_common "$1" 1; info "bootc guest $1 stopped"; }

destroy_guest() {
  local vmid=$1 root volname
  require_guest "$vmid"
  stop_common "$vmid" 1 || true
  lxc_running "$vmid" && die "guest $vmid is still running; destroy aborted (volume kept)"
  root=$(guest_rootfs "$vmid" 2>/dev/null) || root=""
  if [[ -n $root && -d $root ]]; then
    "$VOSTREE" guest-destroy "$vmid" "$root" 2>/dev/null || true
  fi
  volname=$(conf_get "$vmid" volname)
  if [[ -n $volname ]]; then
    pvesm free "$volname" 2>/dev/null \
      || warn "volume $volname not freed (delete it by hand if wanted)"
  fi
  rm -rf "$(guest_dir "$vmid")"
  rm -f "$(conf_path "$vmid")"
  info "bootc guest $vmid destroyed (volume $volname freed)"
}

status_guest() {
  local vmid=$1 status running init
  require_guest "$vmid"
  status=$(conf_get "$vmid" status); status=${status:-stopped}
  if lxc_running "$vmid"; then
    running=running
    init=$(lxc-info -n "$(lxc_name "$vmid")" -p 2>/dev/null | awk '{print $NF}')
  else
    running=stopped
  fi
  echo "status: $status"
  echo "live-lxc: $running"
  [[ -n ${init:-} ]] && echo "init-pid: $init"
  local idx net
  for idx in 0 1 2; do
    net=$(conf_get "$vmid" "net$idx")
    [[ -n $net ]] && echo "net$idx: $net"
  done
  return 0
}

refresh_guest() {
  local vmid=$1
  require_guest "$vmid"
  "$VOSTREE" refresh "$vmid" || die "refresh failed for $vmid"
  info "bootc guest $vmid refreshed (previous deployment kept for rollback)"
}

usage() { sed -n '10,20p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

NAME=""; DESC=""; ONBOOT=""; NET0=""; NET1=""; NET2=""
main() {
  local cmd=${1:-}; [[ -n $cmd ]] || usage 1
  [[ $cmd == -h || $cmd == --help || $cmd == help ]] && usage 0
  shift
  # Explicit env-set TEMPLATE_STORAGE is honoured; the empty one is resolved
  # from the node's own storage configuration before dispatching.
  resolve_default_storages
  case "$cmd" in
    publish)
      local compose=${1:-}; [[ -n $compose ]] || die "usage: $PROG publish <compose.yml> [--name N]"
      shift
      local args=()
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --name) args+=(--name "$2"); shift 2 ;;
          *) die "unknown option: $1" ;;
        esac
      done
      publish_stack "$compose" "${args[@]}"
      ;;
    templates)
      list_templates
      ;;
    compose-read)
      local stack=${1:-}
      [[ -n $stack ]] || die "usage: $PROG compose-read <stack>"
      read_stack_compose "$stack"
      ;;
    *)
      local vmid=${1:-}
      [[ $vmid =~ ^[0-9]+$ ]] || die "invalid vmid"
      shift
      case "$cmd" in
    create)
      local archive=$1; shift || true
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --name) NAME=$2; shift 2 ;;
          --description) DESC=$2; shift 2 ;;
          --onboot) ONBOOT=$2; shift 2 ;;
          --net0) NET0=$2; shift 2 ;;
          --net1) NET1=$2; shift 2 ;;
          --net2) NET2=$2; shift 2 ;;
          *) die "unknown option: $1" ;;
        esac
      done
      create_guest "$vmid" "$archive"
      ;;
    start) start_guest "$vmid" ;;
    stop) stop_guest "$vmid" ;;
    shutdown) shutdown_guest "$vmid" "${3:-${SHUTDOWN_TIMEOUT:-30}}" ;;
    status) status_guest "$vmid" ;;
    destroy) destroy_guest "$vmid" ;;
    refresh) refresh_guest "$vmid" ;;
    rollback)
      require_guest "$vmid"
      "$VOSTREE" rollback "$vmid" || die "rollback failed for $vmid"
      conf_set "$vmid" status stopped
      info "bootc guest $vmid rolled back to the previous deployment"
      ;;
    -h | --help | help) usage 0 ;;
    *) die "unknown command '$cmd' (try: $PROG --help)" ;;
  esac
      ;;
  esac
}

# Run only when executed directly: sourcing the file (tests) loads the
# functions without dispatching.
if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi