+                upid: response.result.data,
+                autoShow: true,
+            }),
+        });
+    },
+
+    createGuest: function () {
+        let me = this;
+        let vmid = me.vmidField.getValue();
+        let archive = me.archiveField.getValue();
+        if (!vmid || !archive) {
+            Ext.Msg.alert(gettext('Error'), gettext('VMID and seed template are required.'));
+            return;
+        }
+        let params = { vmid: vmid, archive: archive };
+        if (me.nameField.getValue()) {
+            params.name = me.nameField.getValue();
+        }
+        params.onboot = me.onbootField.getValue() ? 1 : 0;
+        Proxmox.Utils.API2Request({
+            method: 'POST',
+            url: `/nodes/${me.node}/bootc`,
+            params: params,
+            failure: (response) => Ext.Msg.alert(gettext('Error'), response.htmlStatus),
+            success: (response) => {
+                me.close();
+                Ext.create('Proxmox.window.TaskProgress', {
+                    upid: response.result.data,
+                    autoShow: true,
+                });
+            },
+        });
+    },
+});
