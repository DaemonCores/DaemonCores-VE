+    // publish the compose stack through the storage plugin; the returned
+    // task UPID opens the build/smoke/publish log; the archive field is
+    // prefilled afterwards so the next step is "Create Guest"
+    publish: function () {
+        let me = this;
+        let stack = me.stackField.getValue() || `bootc-${Date.now()}`;
