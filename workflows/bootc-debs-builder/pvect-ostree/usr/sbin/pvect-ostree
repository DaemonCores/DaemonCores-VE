#!/bin/bash
#
# pvect-ostree — run bootc/OCI images as unprivileged, immutable Proxmox LXC.
#
# Usage:
#   pvect-ostree deploy   <image-ref> <stateroot> <vmid>
#   pvect-ostree create   <vmid> <image-ref> [--rootfs-storage S]
#                         [--mp0-storage S] [--mp1-storage S]
#                         [--mp2-storage S] [pct-option ...]
#   pvect-ostree update   <vmid> [<image-ref>]
#   pvect-ostree rollback <vmid>
#   pvect-ostree remount-all
#   pvect-ostree mount    <vmid>
#   pvect-ostree normalise <vmid>
#   pvect-ostree list
#   pvect-ostree destroy  <vmid>
#   pvect-ostree migrate  <vmid>
#   pvect-ostree retire
#   pvect-ostree build    <compose.yml> [--name N]
#   pvect-ostree publish  <compose.yml> [--name N] [--timer] [--no-test]
#   pvect-ostree templates [<name>]
#   pvect-ostree refresh  <vmid>
#   pvect-ostree adopt    <vmid>
#
# What it does:
#   A bootc image is an OCI image carrying a whole OS. This tool deploys such
#   an image as an ostree/composefs deployment, then presents that deployment
#   as the rootfs of a *standard, unprivileged* Proxmox container:
#
#     * ALL container volumes are standard PVE ones, allocated via the PVE
#       storage API. The target storage is RESOLVED, never a frozen default:
#       an explicit choice (per-volume CONF key or create CLI flag) wins after
#       validation against /etc/pve/storage.cfg content types, and otherwise
#       the first available storage offering the content type is used:
#       - rootfs  = <resolved-rootdir>:<vmid>/subvol-<vmid>-disk-0 (rootdir);
#       - mp0/mp1/mp2 = the writable /etc, /var and /usr/lib/bootc layers,
#         each selectable on its own (MP0/1/2_STORAGE or --mpN-storage),
#         the same way — NEVER host bind mounts (invisible to PVE: no
#         vzdump/move/quota/UI). `migrate` moves legacy binds.
#       - vztmpl seed templates = $TEMPLATE_STORAGE:vztmpl/<stack>.tar.gz
#         (resolved the same way), uploaded through the storage API by `publish`.
#     * The per-CT composefs sysroot lives INSIDE the rootfs volume, under
#       pvect-ostree/sysroot: it is a rebuildable image of what `deploy`
#       staged, re-pullable and jetable — never host state.
#     * The rootfs is the composefs view of the deployment, mounted with
#       `mount.composefs -o idmap=<userns>` so a file owned by root on-disk
#       shows up as the id-mapped range on the host and, through the
#       container's own user namespace, as root inside — no chown of the
#       read-only image and no idmapped-mount of the overlay (which the
#       kernel refuses).
#     * /usr stays read-only and fs-verity-checked (the image is immutable);
#       the container cannot modify its own OS.
#     * Writable /etc and /var are per-container PVE volumes (mp0/mp1) because
#       PVE stages the rootfs non-recursively and would otherwise drop
#       sub-mounts.
#     * The container is `unprivileged: 1` + `features: nesting=1` — exactly
#       the posture of a normal PVE systemd guest, no extra privilege.
#
#   Updates are atomic and roll back: `update` deploys a new image revision and
#   restarts the container onto it; `rollback` restarts onto the previous one.
#   The read-only base means a bad update is undone by pointing back at the
#   prior deployment, never by mutating a live root.
#
#   Compose stacks: `build` and `publish` turn a docker-compose stack into a
#   published LXC template on the PVE vztmpl storage (via compose2bootc,
#   smoke-gated); `pct create <vmid> $TEMPLATE_STORAGE:vztmpl/<stack>.tar.gz` is
#   then the standard entry point — the seed template is adopted at first
#   activation. `refresh` rebuilds a CT from its recorded compose source;
#   `templates` lists the published stacks.
#
#   `retire` removes the legacy plugin storage 'ostree' (refuses while
#   volumes still live on it); the ostree plugin type itself stays installed
#   for migration reads only.
#
# Why the rootfs mount is re-established on boot:
#   The composefs view is a runtime mount; it does not survive a host reboot.
#   The pvect-ostree.service unit runs `remount-all` before pve-guests.service
#   so every managed container finds its rootfs in place at start.
#
# Note on shell options: subcommands validate their own preconditions; we use a
# strict mode but keep error messages actionable.

set -uo pipefail

readonly CONF=/etc/pvect-ostree/pvect-ostree.conf
readonly PROG=${0##*/}

# --- Defaults (overridden by CONF) ------------------------------------------
# Per-CT composefs sysroot: every staged deployment lives INSIDE the CT's own
# rootfs volume, under <rootfs>/pvect-ostree/sysroot — it is re-pullable and
# jetable (publish re-deploy rebuilds it), never host state.
SYSROOT=
STATE_DIR=/var/lib/pvect-ostree/cts # per-CT registry ($STATE_DIR/<vmid>.env)
# Storage targets are resolved at runtime (resolve_default_storages, below)
# from /etc/pve/storage.cfg + pvesm/pveam when left empty here or in CONF.
STORAGE=
TEMPLATE_STORAGE=
ROOTFS_STORAGE=
UID_BASE=100000
UID_RANGE=65536
USERNS=/run/pvect-ostree/userns
ALLOC_TEMPLATE_MATCH=alpine-.*amd64
GUEST_MASK_UNITS=""
COMPOSE_DIR=/var/lib/pvect-ostree/compose # recorded compose sources per stack
# Writable per-CT layer volumes (/etc, /var, /usr/lib/bootc) allocated on the
# PVE storage API when a CT is created or migrated — never host binds.
MP_ETC_SIZE=1   # GB (writable /etc volume)
MP_VAR_SIZE=16  # GB (writable /var volume — service data lives here)
MP_BOOTC_SIZE=16 # GB (writable /usr/lib/bootc image store)
# Per-volume storage targets for the writable layers; empty follows the
# resolved ROOTFS_STORAGE (both CONF- and CLI-selectable per volume).
MP0_STORAGE=
MP1_STORAGE=
MP2_STORAGE=

# shellcheck source=/dev/null
[[ -r $CONF ]] && . "$CONF"
# Derive the template directory from the sysroot unless the CONF set it.
TEMPLATE_DIR=${TEMPLATE_DIR:-$SYSROOT/vztmpl}
COMPOSE_DIR=${COMPOSE_DIR:-/var/lib/pvect-ostree/compose}

readonly REG_DIR="$STATE_DIR" # per-CT registry: $REG_DIR/<vmid>.env

#######################################
# Print an error message and exit non-zero.
# Globals:
#   PROG
# Arguments:
#   $* - message text
# Outputs:
#   Writes "$PROG: <message>" to stderr.
# Returns:
#   Exits 1.
#######################################
die() {
  echo "$PROG: $*" >&2
  exit 1
}

#######################################
# Print a warning message to stderr.
# Globals:
#   PROG
# Arguments:
#   $* - message text
# Outputs:
#   Writes "$PROG: <message>" to stderr.
#######################################
warn() { echo "$PROG: $*" >&2; }

#######################################
# Print an informational message to stdout.
# Globals:
#   PROG
# Arguments:
#   $* - message text
# Outputs:
#   Writes "$PROG: <message>" to stdout.
#######################################
info() { echo "$PROG: $*"; }

#######################################
# Abort unless running as the root user.
# Outputs:
#   Error via die() when not root.
# Returns:
#   Exits 1 when not root.
#######################################
need_root() { [[ $(id -u) -eq 0 ]] || die "must run as root"; }

#######################################
# Verify the image-deployment toolchain is on PATH (deploy path only).
# Globals:
#   PROG
# Outputs:
#   Error via die() naming the missing command.
# Returns:
#   Exits 1 when podman is not found.
#######################################
need_podman() {
  command -v podman >/dev/null 2>&1 \
    || die "missing required tool: podman (deploy needs it to flatten the image)"
}

#######################################
# Verify every required external tool is on PATH.
# Outputs:
#   Error via die() naming the first missing tool.
# Returns:
#   Exits 1 when a tool is missing.
#######################################
need_tools() {
  local t
  for t in ostree mount.composefs pct pvesm unshare; do
    command -v "$t" >/dev/null 2>&1 || die "missing required tool: $t"
  done
}

#######################################
# Verify the compose toolchain is on PATH (build/publish path only).
# Globals:
#   PROG
# Outputs:
#   Error via die() naming the missing command.
# Returns:
#   Exits 1 when compose2bootc is not found.
#######################################
need_compose() {
  command -v compose2bootc >/dev/null 2>&1 \
    || die "missing required tool: compose2bootc (install the compose2bootc package)"
}

# Location of the PVE storage configuration (respected overrides are for
# tests only; production always reads the real pmxcfs file).
STORAGE_CFG=${PVECT_STORAGE_CFG:-/etc/pve/storage.cfg}

#######################################
# Print the storage ids whose /etc/pve/storage.cfg stanza declares
# 'content <type>', in declaration order. No invented names: only what PVE
# itself has configured is ever considered.
# Arguments:
#   $1 - content type (vztmpl, rootdir, ...)
# Outputs:
#   Storeid list on stdout (one per line).
#######################################
storage_ids_with_content() {
  local want=$1
  awk -v w="$want" '
    /^[[:space:]]*(#|$)/ { next }
    /^[^[:space:]]/ {
      # Stanza line "type: <storeid>": the first colon delimits the plugin
      # type, the storeid runs until the next whitespace.
      sid = $0
      sub(/^[^:]*:[[:space:]]*/, "", sid)
      sub(/[[:space:]].*$/, "", sid)
      if (sid == "") { next }
      if (!(sid in seen)) { seen[sid] = 1; order[++n] = sid }
      cur = sid
      next
    }
    $1 == "content" {
      # Both PVE spellings parse: "content rootdir,images" (comma-separated)
      # and "content rootdir images" (whitespace) — normalise to a comma list.
      line = $0
      sub(/^[[:space:]]*content[[:space:]]+/, "", line)
      gsub(/[[:space:],]+/, ",", line)
      content[cur] = content[cur] "," line
    }
    END {
      for (i = 1; i <= n; i++)
        if (index("," content[order[i]] ",", "," w) > 0) print order[i]
    }
  ' "$STORAGE_CFG"
}

#######################################
# Print the first DECLARED storage with 'content <type>' that pvesm also
# reports active for that content type (the declaration order of
# /etc/pve/storage.cfg is the tiebreak-free deterministic order).
# Arguments:
#   $1 - content type (vztmpl, rootdir, ...)
# Outputs:
#   Storeid on stdout; exit 1 when no candidate is active.
#######################################
first_active_storage() {
  local want=$1 sid active
  active=$(pvesm status -content "$want" 2>/dev/null \
    | awk '$3 == "active" {print $1}')
  for sid in $(storage_ids_with_content "$want"); do
    if grep -qxF "$sid" <<<"$active"; then
      echo "$sid"
      return 0
    fi
  done
  return 1
}

#######################################
# Print the default vztmpl target: among the vztmpl-capable storages, one
# that already holds templates wins (templates stay where they are), else
# the first active vztmpl-capable storage. Detection is /etc/pve/storage.cfg
# ordering + pveam listing — never a hard-coded storeid.
# Outputs:
#   Storeid on stdout; exit 1 when no vztmpl-capable storage is usable.
#######################################
default_template_storage() {
  local sid
  for sid in $(storage_ids_with_content vztmpl); do
    if pveam list "$sid" 2>/dev/null | grep -q .; then
      echo "$sid"
      return 0
    fi
  done
  first_active_storage vztmpl
}

#######################################
# Fill in the storage targets left empty (by defaults or CONF): explicit
# configuration always wins, empty targets are resolved from the PVE
# storage configuration — first active 'content rootdir' for rootfs/mp
# volumes, existing-templates-then-first-vztmpl for seed templates.
# Globals:
#   STORAGE, ROOTFS_STORAGE, TEMPLATE_STORAGE, STORAGE_CFG
#######################################
resolve_default_storages() {
  if [[ -z $ROOTFS_STORAGE ]]; then
    ROOTFS_STORAGE=$(first_active_storage rootdir) || ROOTFS_STORAGE=
  fi
  # STORAGE is the legacy alias for the rootdir target (kept for the
  # subvol-path fallback); it follows ROOTFS_STORAGE unless set explicitly.
  if [[ -z $STORAGE ]]; then
    STORAGE=$ROOTFS_STORAGE
  fi
  if [[ -z $TEMPLATE_STORAGE ]]; then
    TEMPLATE_STORAGE=$(default_template_storage) || TEMPLATE_STORAGE=
  fi
}

#######################################
# Print the storeid backing a container volume (rootfs subvol or writable mp
# layer). Selection order: explicit per-volume choice (create CLI flag or MP
# CONF key) wins after validation against the /etc/pve/storage.cfg content
# declarations — an unknown storeid is a hard error, not a silent fallback;
# an empty choice follows the fallback (the resolved ROOTFS_STORAGE) and, if
# even that is unusable, the first active storage with the content type.
# Never a hard-coded name.
# Globals:
#   STORAGE_CFG
# Arguments:
#   $1 - content type (rootdir)
#   $2 - preferred storeid ('' allowed)
#   $3 - fallback storeid when the preferred is empty ('' allowed)
#   $4 - context label used in error messages
# Outputs:
#   Storeid on stdout; error via die() when nothing usable resolves.
#######################################
volume_storage() {
  local want=$1 pref=$2 fallback=$3 label=$4
  if [[ -n $pref ]]; then
    if storage_ids_with_content "$want" | grep -qxF "$pref"; then
      echo "$pref"
      return 0
    fi
    die "storage '$pref' (volume '$label') offers no 'content $want'"
  fi
  if [[ -n $fallback ]] \
    && storage_ids_with_content "$want" | grep -qxF "$fallback"; then
    echo "$fallback"
    return 0
  fi
  first_active_storage "$want" \
    || die "no active storage with 'content $want' for volume '$label'"
}

#######################################
# Pin a 0 -> UID_BASE user namespace so mount.composefs can id-shift the
# read-only image. Idempotent; re-pins after a reboot cleared /run.
# Globals:
#   USERNS, UID_BASE, UID_RANGE
# Outputs:
#   Error via die() if the namespace cannot be created or pinned.
# Returns:
#   0 on success; exits 1 on failure.
#######################################
pin_userns() {
  mkdir -p "$(dirname "$USERNS")"
  if mountpoint -q "$USERNS" 2>/dev/null; then
    return 0
  fi
  local upid self_ns cur_ns
  unshare -U sleep infinity &
  upid=$!
  # /proc/PID/uid_map always exists (even in the initial userns), so wait until
  # the child is actually in a NEW user namespace before writing the map,
  # otherwise the write targets the initial namespace and fails with EPERM.
  self_ns=$(readlink /proc/self/ns/user)
  for _ in $(seq 1 100); do
    cur_ns=$(readlink "/proc/$upid/ns/user" 2>/dev/null) || {
      sleep 0.02
      continue
    }
    [[ -n $cur_ns && $cur_ns != "$self_ns" ]] && break
    sleep 0.02
  done
  [[ -n ${cur_ns:-} && $cur_ns != "$self_ns" ]] \
    || {
      kill "$upid" 2>/dev/null
      die "user namespace did not initialise"
    }
  printf '0 %s %s\n' "$UID_BASE" "$UID_RANGE" >"/proc/$upid/uid_map" \
    || {
      kill "$upid" 2>/dev/null
      die "failed to write uid_map"
    }
  printf '0 %s %s\n' "$UID_BASE" "$UID_RANGE" >"/proc/$upid/gid_map" \
    || {
      kill "$upid" 2>/dev/null
      die "failed to write gid_map"
    }
  : >"$USERNS"
  mount --bind "/proc/$upid/ns/user" "$USERNS" \
    || {
      kill "$upid" 2>/dev/null
      die "failed to pin userns"
    }
  # The pinned bind keeps the namespace alive; the holder process may exit.
  kill "$upid" 2>/dev/null
  return 0
}

#######################################
# Initialise an ostree sysroot and enable composefs generation.
# Globals:
#   None
# Arguments:
#   $1 - sysroot directory
# Outputs:
#   Error via die() on ostree failure.
# Returns:
#   Exits 1 on failure.
#######################################
ensure_sysroot() {
  local sysroot=$1
  if [[ ! -d "$sysroot/ostree" ]]; then
    mkdir -p "$sysroot"
    ostree admin init-fs --modern "$sysroot" \
      || die "ostree admin init-fs failed"
  fi
  # Guarantee a .ostree.cfs is generated for every deployment.
  ostree config --repo="$sysroot/ostree/repo" set ex-integrity.composefs true \
    || die "ostree config ex-integrity.composefs failed"
}

#######################################
# Print the newest deployment directory for a stateroot ('' if none).
# Globals:
#   None
# Arguments:
#   $1 - stateroot name
#   $2 - sysroot directory
# Outputs:
#   Deployment directory path on stdout.
#######################################
deploy_path() {
  local stateroot=$1 sysroot=$2
  # Newest by mtime: commit checksums sort lexicographically, not by age, so
  # the `.0` suffix alone (find + sort) can pick a stale deployment.
  ls -td "$sysroot/ostree/deploy/$stateroot/deploy"/*.0 2>/dev/null | head -1
}

#######################################
# Print the previous deployment directory ('' if only one exists).
# Globals:
#   None
# Arguments:
#   $1 - stateroot name
#   $2 - sysroot directory
# Outputs:
#   Deployment directory path on stdout.
#######################################
deploy_path_prev() {
  local stateroot=$1 sysroot=$2
  # Second newest by mtime (same caveat as deploy_path: no lexicographic sort).
  ls -td "$sysroot/ostree/deploy/$stateroot/deploy"/*.0 2>/dev/null | sed -n 2p
}

#######################################
# Print the registry file path for a container.
# Globals:
#   REG_DIR
# Arguments:
#   $1 - vmid
# Outputs:
#   Registry file path on stdout.
#######################################
reg_file() { echo "$REG_DIR/$1.env"; }

#######################################
# Source the registry entry for a container into the environment.
# Arguments:
#   $1 - vmid
# Outputs:
#   Error via die() if the entry is absent.
# Returns:
#   Exits 1 when the container is unmanaged.
#######################################
reg_load() {
  local f
  f=$(reg_file "$1")
  [[ -r $f ]] || die "container $1 is not managed by pvect-ostree ($f absent)"
  # shellcheck source=/dev/null
  . "$f"
}

#######################################
# Write the registry entry for a container.
# Globals:
#   REG_DIR
# Arguments:
#   $1 - vmid
#   $2 - stateroot
#   $3 - image reference
# Outputs:
#   Creates $REG_DIR/<vmid>.env.
#######################################
reg_write() {
  local vmid=$1 stateroot=$2 imgref=$3 compose=${4:-}
  mkdir -p "$REG_DIR"
  cat >"$(reg_file "$vmid")" <<EOF
VMID=$vmid
STATEROOT=$stateroot
IMGREF='$imgref'
COMPOSE='$compose'
EOF
}

#######################################
# Print the rootfs subvol path allocated for a CT on the dir storage.
#
# Resolution order:
#   1. the volume recorded in the CT config itself (pct config rootfs) — the
#      created volume is authoritative wherever it lives (any storeid);
#   2. the configured dir storage (STORAGE).
# Globals:
#   STORAGE
# Arguments:
#   $1 - vmid
# Outputs:
#   Subvol path on stdout.
#######################################
subvol_path() {
  local vmid=$1 base vol
  # The CT config records exactly which volume PVE allocated for the rootfs
  # (`pct create --rootfs <storeid>:0` may point anywhere).
  vol=$(pct config "$vmid" 2>/dev/null | awk '/^rootfs: /{print $2; exit}')
  # Storage options (`pct config` records the volume with its options, e.g.
  # `size=0T`) are not part of the volume id — strip them before resolving.
  vol=${vol%%,*}
  if [[ -n $vol ]]; then
    base=$(pvesm path "$vol" 2>/dev/null)
    if [[ -n $base ]]; then
      echo "$base"
      return 0
    fi
  fi
  # Fall back to the configured dir storage.
  for s in "$STORAGE"; do
    base=$(pvesm path "$s:$vmid/subvol-$vmid-disk-0.subvol" 2>/dev/null)
    if [[ -n $base ]]; then
      echo "$base"
      return 0
    fi
  done
  # Fall back to the documented dir-storage layout, honouring the storage's
  # configured path (defaulting to /var/lib/vz if it cannot be resolved).
  local dir
  dir=$(awk -v s="$STORAGE" '
    $1 == "dir:" { in_s = ($2 == s) }
    in_s && $1 == "path" { print $2; exit }
  ' /etc/pve/storage.cfg 2>/dev/null)
  echo "${dir:-/var/lib/vz}/images/$vmid/subvol-$vmid-disk-0.subvol"
}

#######################################
# Print the writable per-CT /etc layer host path.
#
# Volume-backed CTs: the host path of the mp0 volume; legacy (pre-migration)
# CTs: the registered host tree. Read-only helper; never a mount target.
# Globals:
#   STATE_DIR
# Arguments:
#   $1 - vmid
# Outputs:
#   Layer host path on stdout.
#######################################
ct_etc() { mp_vol_path "$1" mp0 || echo "$STATE_DIR/$1/etc"; }

#######################################
# Print the writable per-CT /var layer host path (same resolution as ct_etc).
# Globals:
#   STATE_DIR
# Arguments:
#   $1 - vmid
# Outputs:
#   Layer host path on stdout.
#######################################
ct_var() { mp_vol_path "$1" mp1 || echo "$STATE_DIR/$1/var"; }

#######################################
# Print the writable per-CT /usr/lib/bootc shadow host path.
# Globals:
#   STATE_DIR
# Arguments:
#   $1 - vmid
# Outputs:
#   Bootc shadow path on stdout.
#######################################
ct_bootc() { mp_vol_path "$1" mp2 || echo "$STATE_DIR/$1/bootc"; }

#######################################
# Print the host path of a PVE mp volume allocated for a CT ('' if the mp is
# a legacy host-path bind or absent).
# Globals:
#   None
# Arguments:
#   $1 - vmid
#   $2 - mp slot (mp0, mp1, ...)
# Outputs:
#   Host path on stdout.
#######################################
mp_vol_path() {
  local vmid=$1 mpx=$2 line vol
  line=$(pct config "$vmid" 2>/dev/null | awk -v m="^$mpx: " '$0 ~ m {print; exit}')
  [[ -n $line ]] || return 1
  vol=${line#"$mpx": }
  vol=${vol%%,*}
  [[ $vol == /* ]] && return 1 # legacy host-path bind, not a volume
  pvesm path "$vol" || return 1
}

#######################################
# Print the per-CT composefs sysroot, hosted INSIDE the CT rootfs volume
# (subfolder pvect-ostree/ — re-pullable, jetable, never host state).
# Globals:
#   None
# Arguments:
#   $1 - vmid
# Outputs:
#   Sysroot path on stdout.
#######################################
ct_sysroot() { echo "$(subvol_path "$1")/pvect-ostree/sysroot"; }

#######################################
# Shadow /usr/lib/bootc with a writable copy plus the storage/ directory.
#
# In a bootc image, /usr/lib/bootc/storage is a build-time symlink into the
# build sysroot (/sysroot/ostree/bootc/storage); inside a container nothing
# provides /sysroot, and podman (which enters bootc image-store mode as soon
# as /run/ostree exists) then dies on every service with "can't stat
# imageStore dir". A writable copy of the image's /usr/lib/bootc (quadlets
# keep the build-side bookkeeping) plus an empty storage/ directory restores
# a usable additional image store; service images are loaded there by hand.
# Globals:
#   UID_BASE
# Arguments:
#   $1 - vmid
#   $2 - deployment directory
#######################################
build_bootc_shadow() {
  local vmid=$1 deploy=$2 shadow
  shadow=$(ct_bootc "$vmid")
  [[ -d $deploy/usr/lib/bootc ]] || return 0
  if [[ ! -d $shadow/bound-images.d ]]; then
    mkdir -p "$shadow"
    cp -a "$deploy/usr/lib/bootc/." "$shadow/" \
      || die "cannot seed the bootc shadow from $deploy/usr/lib/bootc"
  fi
  mkdir -p "$shadow/storage"
  chown -R "$UID_BASE:$UID_BASE" "$shadow"
}

#######################################
# Build the writable /etc from the deployment's default /usr/etc and mask the
# host-only units so the guest boots clean. Only (re)builds /etc when it is
# missing, to preserve local changes across updates.
#
# The layers are the PVE mp VOLUMES (mp0=/etc, mp1=/var, mp2=/usr/lib/bootc)
# resolved host-side via pct config; legacy (pre-migration) CTs still resolve
# to the registered host trees, which is where their data lives until
# `pvect-ostree migrate` moves it.
# Globals:
#   GUEST_MASK_UNITS, UID_BASE, STATEROOT
# Arguments:
#   $1 - vmid
# Outputs:
#   Error via die() if /etc cannot be seeded.
# Returns:
#   Exits 1 on failure.
#######################################
build_writable_layers() {
  local vmid=$1
  local etc var u deploy
  etc=$(ct_etc "$vmid")
  var=$(ct_var "$vmid")
  # The deployment tree (plain checkout inside the per-CT sysroot) carries the
  # seed /etc and the bootc shadow sources — readable host-side without the
  # composefs mount.
  # shellcheck disable=SC2153  # STATEROOT sourced from the registry entry.
  deploy=$(deploy_path "$STATEROOT" "$(ct_sysroot "$vmid")")

  mkdir -p "$var"
  if [[ ! -d "$etc/systemd" ]]; then
    mkdir -p "$etc/systemd/system"
    local seed
    seed="$deploy/usr/etc"
    # Bootc images may carry the default /etc either under /usr/etc (composefs
    # layout) or straight at /etc — seed whichever the deployment actually has.
    [[ -d $seed ]] || seed="$deploy/etc"
    cp -a "$seed/." "$etc/" 2>/dev/null \
      || die "cannot seed /etc from $seed"
    # /etc/os-release is a symlink into /usr/lib in Debian/bootc images; the
    # writable seed sits outside the composefs view, so materialise the real
    # file or PVE::LXC::Setup fails with "can't open /etc/os-release".
    if [[ -L $etc/os-release ]]; then
      rm -f "$etc/os-release"
      cp -L "$seed/os-release" "$etc/os-release" 2>/dev/null \
        || cp -L "$deploy/usr/lib/os-release" "$etc/os-release" 2>/dev/null \
        || die "cannot materialise /etc/os-release from $seed"
    fi
    for u in $GUEST_MASK_UNITS; do
      ln -sf /dev/null "$etc/systemd/system/$u"
    done
  fi
  # PVE never writes the resolver for an unmanaged guest; aardvark-dns (netavark
  # DNS) needs one at service start, so seed the host resolver once.
  if [[ ! -s $etc/resolv.conf && -r /etc/resolv.conf ]]; then
    cp /etc/resolv.conf "$etc/resolv.conf"
  fi
  # Some image /etc trees ship podman without policy.json; pulls then fail with
  # "no policy.json file found". Fall back to the accept-by-default policy.
  mkdir -p "$etc/containers"
  if [[ ! -e $etc/containers/policy.json ]]; then
    printf '%s\n' '{"default":[{"type":"insecureAcceptAnything"}]}' \
      >"$etc/containers/policy.json"
  fi
  chown -R "$UID_BASE:$UID_BASE" "$etc" "$var"
  build_bootc_shadow "$vmid" "$deploy"
}

#######################################
# Mount the composefs view (id-shifted) onto the CT rootfs subvol.
# Globals:
#   USERNS
# Arguments:
#   $1 - vmid
# Outputs:
#   Error via die() on any precondition or mount failure.
# Returns:
#   0 on success (or already mounted); exits 1 on failure.
#######################################
mount_rootfs() {
  local vmid=$1
  reg_load "$vmid"
  pin_userns

  local deploy root sysroot
  # STATEROOT comes from the sourced registry .env (reg_load above).
  # shellcheck disable=SC2153
  root=$(subvol_path "$vmid")
  [[ -d $root ]] || die "rootfs subvol missing: $root (was the CT created?)"
  # The per-CT sysroot lives inside the rootfs volume (re-pullable, jetable).
  sysroot="$root/pvect-ostree/sysroot"
  deploy=$(deploy_path "$STATEROOT" "$sysroot")
  [[ -n $deploy ]] || die "no deployment for CT $vmid (stateroot $STATEROOT)"

  if mountpoint -q "$root"; then
    return 0 # already mounted (e.g. CT already running)
  fi

  # Stage the writable /etc + /var + bootc layers into the PVE mp volumes.
  build_writable_layers "$vmid" ""

  # The subvol PVE allocated may hold leftover template content; clear it so
  # the composefs view is what the container sees. The pvect-ostree/ folder
  # (sysroot) is protected — the mounts read out of it while it is shadowed
  # behind the composefs view.
  find "$root" -mindepth 1 -name pvect-ostree -prune -o -mindepth 1 \
    -print0 | xargs -0 -r rm -rf -- 2>/dev/null || true

  # The digest store lives inside the deployment (mkcomposefs names its files
  # by content digest); fall back to the bare repo objects for older layouts.
  local store="$deploy/.ostree-cfs-store"
  local basedir="$sysroot/ostree/repo/objects"
  [[ -d $store ]] && basedir="$store"
  mount -t composefs "$deploy/.ostree.cfs" \
    -o "basedir=$basedir,idmap=$USERNS" "$root" \
    || die "mount.composefs failed for CT $vmid"
}

#######################################
# Recursively unmount the CT rootfs subvol if it is mounted.
# Arguments:
#   $1 - vmid
# Returns:
#   Always 0.
#######################################
umount_rootfs() {
  local vmid=$1 root
  root=$(subvol_path "$vmid")
  mountpoint -q "$root" 2>/dev/null && umount -R "$root" 2>/dev/null
  return 0
}

#######################################
# Normalise a CT config for the pvect-ostree posture (sourced from the
# pve-container prestart-hook code):
#   - no idmap= on rootfs   -> avoids the fatal mount_setattr on the overlay
#   - ostype: unmanaged     -> PVE does not rewrite our /etc
#   - apparmor param bind   -> apparmor.service skips instead of asserting
#   - mp0=/etc mp1=/var     -> writable layers as PVE mp VOLUMES (storage API
#                              allocated, host-bind-free); legacy host-path
#                              binds are migrated by `pvect-ostree migrate`.
# Globals:
#   ROOTFS_STORAGE, MP0_STORAGE, MP1_STORAGE, MP2_STORAGE,
#   MP_ETC_SIZE, MP_VAR_SIZE, MP_BOOTC_SIZE
# Arguments:
#   $1 - vmid
# Outputs:
#   Error via die() if the CT config is absent or an allocation fails.
# Returns:
#   Exits 1 when the config is missing.
#######################################
normalise_conf() {
  local vmid=$1 conf="/etc/pve/lxc/$1.conf"
  [[ -f $conf ]] || die "CT config not found: $conf"

  sed -i 's/,idmap=passthrough//; s/,idmap=[^, ]*//' "$conf"
  sed -i 's/^ostype:.*/ostype: unmanaged/' "$conf"
  grep -q '^ostype:' "$conf" || echo 'ostype: unmanaged' >>"$conf"
  grep -q 'sys/module/apparmor/parameters/enabled' "$conf" \
    || cat >>"$conf" <<'EOF'
lxc.mount.entry: /dev/null sys/module/apparmor/parameters/enabled none bind 0 0
EOF
  # The composefs view is read-only: give systemd its volatile dirs (tmpfs
  # mount entries are applied onto the rootfs by lxc at start).
  grep -q 'lxc.mount.entry: tmpfs run tmpfs' "$conf" \
    || cat >>"$conf" <<'EOF'
lxc.mount.entry: tmpfs run tmpfs rw,nosuid,nodev,create=dir,optional 0 0
lxc.mount.entry: tmpfs tmp tmpfs rw,nosuid,nodev,create=dir,optional 0 0
EOF
  # Allocate the writable layers that are missing from the config: a fresh
  # `create` carries them already (--mp0/1/2 via the storage API); a CT
  # normalised before the volume rework carries host-path binds which are ONLY
  # replaced by the guarded `migrate` flow (data copied first), never here.
  local slot mpoint need mp_pref mp_st
  for slot in 0 1 2; do
    case $slot in
      0) mpoint=/etc; need=mp0; mp_pref=$MP0_STORAGE ;;
      1) mpoint=/var; need=mp1; mp_pref=$MP1_STORAGE ;;
      2) mpoint=/usr/lib/bootc; need=mp2; mp_pref=$MP2_STORAGE ;;
    esac
    grep -qE "^mp$slot: [^/]" "$conf" || grep -qE "^mp$slot: " "$conf" || {
      mp_st=$(volume_storage rootdir "$mp_pref" "$ROOTFS_STORAGE" "$need")
      pct set "$vmid" --mp$slot "$mp_st:1,mp=$mpoint" \
        || die "allocation of $need ($mpoint) on $mp_st failed"
    }
  done
}

#######################################
# Export an OCI image's root filesystem into a plain directory tree.
#
# `ostree container image deploy` does not exist in libostree 2026.5 (the
# container builtins migrated into bootc and were then dropped from the CLI),
# so the deploy is done here by hand: flatten the image through podman
# (create a throwaway container, `podman export` — whiteouts handled by
# the runtime itself), then untar it into the caller's scratch dir.
# Globals:
#   PROG
# Arguments:
#   $1 - image reference
#   $2 - destination directory (created; must be empty or absent)
# Outputs:
#   Progress via info(); errors via die().
# Returns:
#   Exits 1 when the image is unknown or the export fails.
#######################################
export_image_rootfs() {
  local imgref=$1 dst=$2 probe="pvect-export-$$"
  if ! podman image exists "$imgref"; then
    info "pulling $imgref"
    podman pull "$imgref" >/dev/null \
      || die "image $imgref not found locally and pull failed"
  fi
  podman create --entrypoint /bin/true --name "$probe" "$imgref" >/dev/null \
    || die "cannot create the export container for $imgref"
  mkdir -p "$dst"
  if ! podman export "$probe" | tar -x -C "$dst"; then
    podman rm -f "$probe" >/dev/null 2>&1
    die "rootfs export failed for $imgref"
  fi
  podman rm -f "$probe" >/dev/null 2>&1
  [[ -d $dst/usr ]] || die "$imgref does not look like a rootfs (no /usr)"
}

#######################################
# Reshape an exported container rootfs into the ostree deployment layout.
#
# libostree seeds the deployment's /etc from the commit's /usr/etc (the
# build_writable_layers seed path uses exactly that), while the composefs view
# still needs an /etc dir to receive the mp0 bind mount. So the tree keeps
# /etc and a copy of it at /usr/etc. Volatile runtime dirs are emptied: the
# composefs view is read-only, /run and /tmp are covered by tmpfs mount
# entries written by normalise_conf.
# Arguments:
#   $1 - tree directory
#######################################
reshape_tree() {
  local tree=$1
  if [[ -d $tree/etc && ! -e $tree/usr/etc ]]; then
    cp -a "$tree/etc" "$tree/usr/etc" \
      || die "cannot copy /etc into /usr/etc (seed layout)"
  fi
  [[ -e $tree/usr/etc ]] || die "no /etc and no /usr/etc in the image"
  rm -rf "$tree/run" "$tree/tmp" 2>/dev/null
  mkdir -p "$tree/run" "$tree/tmp" "$tree/var" "$tree/etc"
}

#######################################
# Hand-build the stateroot deployment libostree normally writes for us.
#
# `ostree admin deploy` refuses trees without a kernel (no provision for
# non-booting bootc containers), so the deployment directory is assembled
# here in the exact layout the rest of this tool expects:
#   <sysroot>/ostree/deploy/<stateroot>/deploy/<commit>.0/  checked-out tree
#   <commit>.0/.ostree.cfs                                  composefs view
#   <commit>.0.origin                                       bookkeeping
# The newest deployment is index .0 (deploy_path), the previous one sits at
# .1 for rollback (deploy_path_prev); existing indexes shift up on deploy.
# Globals:
#   SYSROOT
# Arguments:
#   $1 - stateroot name
#   $2 - commit checksum
#   $3 - image reference (recorded in the origin file)
# Outputs:
#   Errors via die().
# Returns:
#   Exits 1 when the checkout or the composefs generation fails.
#######################################
deployment_write() {
  local sysroot=$1 stateroot=$2 commit=$3 imgref=$4
  local parent dst max i
  parent="$sysroot/ostree/deploy/$stateroot/deploy"
  mkdir -p "$parent"
  # Shift every existing index up so the newest stays .0 (new commit wins,
  # the old .0 drops to .1 and remains the rollback target).
  shopt -s nullglob
  max=0
  for dst in "$parent"*.[0-9]; do
    i=${dst##*.}
    (( i > max )) && max=$i
  done
  for (( i = max; i >= 0; i-- )); do
    for dst in "$parent"*.$i; do
      mv "$dst" "${dst%.*}.$(( i + 1 ))"
    done
  done
  shopt -u nullglob
  dst=$parent/$commit.0
  ostree checkout --repo="$sysroot/ostree/repo" --disable-cache \
    "$commit" "$dst" \
    || die "ostree checkout of $commit failed"
  # libostree's deploy would create an empty var/ (initial-var); mirror it.
  mkdir -p "$dst/var"
  # The composefs backing files must be named by their content digest; keep
  # them in a dedicated digest store beside the image (mkcomposefs writes one
  # entry per unique file content), not the bare repo's `<object>.file` names.
  mkcomposefs --digest-store="$dst/.ostree-cfs-store" "$dst" "$dst/.ostree.cfs" \
    || die "mkcomposefs failed for $dst"
  {
    echo "[origin]"
    echo "refspec=ostree/$stateroot"
    echo "branch=ostree/$stateroot"
    echo "imgref=$imgref"
  } >"$dst.origin"
}

#######################################
# Deploy an image to a stateroot inside a CT's own sysroot.
#
# Reimplemented for libostree 2026.x without the `ostree container` builtins
# (voie (c)): flatten the OCI image with podman, commit the tree into the CT
# sysroot repo (hosted INSIDE the rootfs volume), then assemble the stateroot
# deployment by hand (deployment_write). The kernel-free layout rule applies:
# nothing here invokes `ostree admin deploy` (it refuses trees without a
# kernel).
# Globals:
#   PROG
# Arguments:
#   $1 - image reference
#   $2 - stateroot
#   $3 - sysroot directory (rootfs-volume-backed)
# Outputs:
#   Progress via info(); errors via die().
# Returns:
#   Exits 1 on failure.
#######################################
cmd_deploy() {
  local imgref=${1:?usage: $PROG deploy <image-ref> <stateroot> <vmid>}
  local stateroot=${2:?usage: $PROG deploy <image-ref> <stateroot> <vmid>}
  local sysroot=${3:?usage: $PROG deploy <image-ref> <stateroot> <vmid>}
  need_root
  need_tools
  need_podman
  ensure_sysroot "$sysroot"

  if [[ ! -d "$sysroot/ostree/deploy/$stateroot" ]]; then
    ostree admin stateroot-init --sysroot "$sysroot" "$stateroot" \
      || die "stateroot-init failed"
  fi

  local work tree commit deploy
  work=$(mktemp -d "$sysroot/deploy-work.XXXXXX")
  tree="$work/rootfs"
  # shellcheck disable=SC2064
  trap "rm -rf '$work'" EXIT

  info "exporting rootfs of $imgref (podman, flatten)"
  export_image_rootfs "$imgref" "$tree"
  reshape_tree "$tree"

  info "committing tree to the ostree repo (branch ostree/$stateroot)"
  commit=$(ostree commit --repo="$sysroot/ostree/repo" \
    --branch "ostree/$stateroot" --tree=dir="$tree" \
    --subject "bootc image deploy") \
    || die "ostree commit failed"
  rm -rf "$work"

  info "deploying $imgref -> stateroot $stateroot (deployment_write)"
  deployment_write "$sysroot" "$stateroot" "$commit" "$imgref"
  deploy=$(deploy_path "$stateroot" "$sysroot")
  [[ -n $deploy ]] || die "deployment_write produced no deployment directory"
  ostree admin status --sysroot "$sysroot" 2>/dev/null || true
  info "deployment: $deploy (commit $commit)"
}

#######################################
# Resolve (downloading if needed) a throwaway template used only so PVE
# creates the dir subvol; its content is replaced by the composefs view.
# Globals:
#   STORAGE, ALLOC_TEMPLATE_MATCH
# Outputs:
#   Template name on stdout; errors via die().
# Returns:
#   Exits 1 when no template can be resolved.
#######################################
alloc_template() {
  if [[ -z $TEMPLATE_STORAGE ]]; then
    die "no storage with 'content vztmpl' found in $STORAGE_CFG (set TEMPLATE_STORAGE in $CONF)"
  fi
  local t
  t=$(pveam list "$TEMPLATE_STORAGE" 2>/dev/null | awk -v m="$ALLOC_TEMPLATE_MATCH" \
    '$1 ~ m {print $1}' | sed 's#.*/##' | tail -1)
  if [[ -z $t ]]; then
    pveam update >/dev/null 2>&1 || true
    local avail
    avail=$(pveam available --section system 2>/dev/null \
      | awk -v m="$ALLOC_TEMPLATE_MATCH" '$2 ~ m {print $2}' | tail -1)
    # Equivalent to `[[ -n $avail ]] || die ...`, split so the (unwrappable,
    # output-preserving) error message fits within 80 columns.
    if [[ -z $avail ]]; then
      die "no '$ALLOC_TEMPLATE_MATCH' template available to allocate the rootfs"
    fi
    pveam download "$TEMPLATE_STORAGE" "$avail" >/dev/null 2>&1 \
      || die "template download failed"
    t=$(pveam list "$TEMPLATE_STORAGE" 2>/dev/null | awk -v m="$ALLOC_TEMPLATE_MATCH" \
      '$1 ~ m {print $1}' | sed 's#.*/##' | tail -1)
  fi
  [[ -n $t ]] || die "could not resolve an allocation template"
  echo "$t"
}

#######################################
# Create a new pvect-ostree container: allocate the rootfs + writable-layer
# volumes via the PVE storage API, deploy the image into the per-CT sysroot
# (inside the rootfs volume), mount the composefs view, normalise the config.
# Globals:
#   PROG, ROOTFS_STORAGE, MP0_STORAGE, MP1_STORAGE, MP2_STORAGE, STORAGE_CFG
# Arguments:
#   $1  - vmid
#   $2  - image reference
#   $3+ - per-volume storage flags (--rootfs-storage, --mpN-storage) and
#         extra pct create options
# Outputs:
#   Progress via info(); errors via die().
# Returns:
#   Exits 1 on failure.
#######################################
cmd_create() {
  local vmid=${1:?usage: $PROG create <vmid> <image-ref> [pct-option ...]}
  local imgref=${2:?usage: $PROG create <vmid> <image-ref> [pct-option ...]}
  shift 2
  need_root
  need_tools
  # Extraction/copy steps run in a user namespace; a restricted cwd ($PWD=/root,
  # mode 700) makes tar exit 2 ("failed to return to initial working directory").
  # Anchor every command to / before touching the tree.
  cd /
  [[ -f "/etc/pve/lxc/$vmid.conf" ]] && die "CT $vmid already exists"

  # Per-volume storage choice at creation: --rootfs-storage/--mpN-storage win
  # over the CONF preference (MPn_STORAGE), anything empty follows the
  # resolved ROOTFS_STORAGE — every candidate is validated against the
  # storage.cfg content declarations, never hard-coded.
  local arg roots_pref="" mp0_pref="" mp1_pref="" mp2_pref=""
  local pct_opts=()
  while (($#)); do
    arg=$1
    shift
    case $arg in
      --rootfs-storage=*) roots_pref=${arg#*=} ;;
      --rootfs-storage) roots_pref=${1?--rootfs-storage needs a value}; shift ;;
      --mp0-storage=*) mp0_pref=${arg#*=} ;;
      --mp0-storage) mp0_pref=${1?--mp0-storage needs a value}; shift ;;
      --mp1-storage=*) mp1_pref=${arg#*=} ;;
      --mp1-storage) mp1_pref=${1?--mp1-storage needs a value}; shift ;;
      --mp2-storage=*) mp2_pref=${arg#*=} ;;
      --mp2-storage) mp2_pref=${1?--mp2-storage needs a value}; shift ;;
      *) pct_opts+=("$arg") ;;
    esac
  done

  local rootfs_st mp0_st mp1_st mp2_st
  rootfs_st=$(volume_storage rootdir "${roots_pref:-$ROOTFS_STORAGE}" \
    "${roots_pref:+$ROOTFS_STORAGE}" rootfs)
  mp0_st=$(volume_storage rootdir "${mp0_pref:-$MP0_STORAGE}" "$rootfs_st" mp0)
  mp1_st=$(volume_storage rootdir "${mp1_pref:-$MP1_STORAGE}" "$rootfs_st" mp1)
  mp2_st=$(volume_storage rootdir "${mp2_pref:-$MP2_STORAGE}" "$rootfs_st" mp2)
  info "volume stores: rootfs=$rootfs_st mp0=$mp0_st mp1=$mp1_st mp2=$mp2_st"

  local tmpl
  tmpl=$(alloc_template)
  info "allocating rootfs + writable layers via pct create (template $tmpl, discarded)"
  pct create "$vmid" "$TEMPLATE_STORAGE:vztmpl/$tmpl" \
    --unprivileged 1 --features nesting=1 \
    --hostname "ct$vmid" --rootfs "$rootfs_st:0" \
    --mp0 "$mp0_st:$MP_ETC_SIZE,mp=/etc" \
    --mp1 "$mp1_st:$MP_VAR_SIZE,mp=/var" \
    --mp2 "$mp2_st:$MP_BOOTC_SIZE,mp=/usr/lib/bootc" \
    --net0 name=eth0,bridge=vmbr0,ip=dhcp,type=veth,firewall=1 \
    "${pct_opts[@]}" \
    || die "pct create failed"

  local stateroot="ct$vmid"
  reg_write "$vmid" "$stateroot" "$imgref"
  cmd_deploy "$imgref" "$stateroot" "$(ct_sysroot "$vmid")"

  normalise_conf "$vmid"
  mount_rootfs "$vmid"
  info "CT $vmid created. Start it from the Web UI or: pct start $vmid"
}

#######################################
# Update a container to a new image revision, keeping the previous deployment
# for rollback. Restarts the CT onto the new deployment if it was running.
# Globals:
#   PROG, STATEROOT, IMGREF
# Arguments:
#   $1 - vmid
#   $2 - image reference (default: registered IMGREF)
# Outputs:
#   Progress via info(); errors via die().
# Returns:
#   Exits 1 on failure.
#######################################
cmd_update() {
  local vmid=${1:?usage: $PROG update <vmid> [<image-ref>]}
  reg_load "$vmid"
  # shellcheck disable=SC2153  # COMPOSE comes from the sourced registry entry.
  local compose_saved=$COMPOSE # preserved across the update (used by refresh).
  local imgref=${2:-$IMGREF}
  need_root
  need_tools

  local running=0
  [[ "$(pct status "$vmid" 2>/dev/null)" == *running* ]] && running=1
  [[ $running -eq 1 ]] && pct shutdown "$vmid" --timeout 60 2>/dev/null

  cmd_deploy "$imgref" "$STATEROOT" "$(ct_sysroot "$vmid")"
  reg_write "$vmid" "$STATEROOT" "$imgref" "$compose_saved"
  umount_rootfs "$vmid"
  mount_rootfs "$vmid"
  [[ $running -eq 1 ]] && pct start "$vmid"
  info "CT $vmid updated to $imgref (previous deployment kept for rollback)"
}

#######################################
# Roll a container back to its previous deployment by undeploying the current
# one. Restarts the CT onto the previous deployment if it was running.
# Globals:
#   PROG, STATEROOT
# Arguments:
#   $1 - vmid
# Outputs:
#   Progress via info(); errors via die().
# Returns:
#   Exits 1 when there is no previous deployment.
#######################################
cmd_rollback() {
  local vmid=${1:?usage: $PROG rollback <vmid>}
  reg_load "$vmid"
  need_root
  need_tools

  # shellcheck disable=SC2153  # STATEROOT comes from the sourced entry above.
  local sysroot
  sysroot=$(ct_sysroot "$vmid")
  local prev
  prev=$(deploy_path_prev "$STATEROOT" "$sysroot")
  [[ -n $prev ]] || die "no previous deployment to roll back to for CT $vmid"

  local running=0
  [[ "$(pct status "$vmid" 2>/dev/null)" == *running* ]] && running=1
  [[ $running -eq 1 ]] && pct shutdown "$vmid" --timeout 60 2>/dev/null

  # Undeploy the current (index 0) so the previous becomes current.
  ostree admin undeploy --sysroot "$sysroot" --stateroot "$STATEROOT" 0 \
    || warn "ostree undeploy reported an error; continuing"
  umount_rootfs "$vmid"
  mount_rootfs "$vmid"
  [[ $running -eq 1 ]] && pct start "$vmid"
  info "CT $vmid rolled back to previous deployment"
}

#######################################
# Mount the rootfs for a single container.
# Globals:
#   PROG
# Arguments:
#   $1 - vmid
# Outputs:
#   Progress via info(); errors via die().
#######################################
cmd_mount() {
  local vmid=${1:?usage: $PROG mount <vmid>}
  need_root
  need_tools
  # A CT created from a published seed template is not registered yet; adopt
  # it first so the plugin's plain `mount ` activates the whole compose path.
  if [[ ! -r $(reg_file "$vmid") ]]; then
    local payload
    payload="$(subvol_path "$vmid")/pvect-ostree/payload.env"
    [[ -r $payload ]] || die "container $vmid is not managed by pvect-ostree"
    info "seed template detected for CT $vmid; adopting"
    cmd_adopt "$vmid"
    return 0
  fi
  mount_rootfs "$vmid"
  info "rootfs mounted for CT $vmid"
}

#######################################
# Unmount the rootfs for a single container.
# Globals:
#   PROG
# Arguments:
#   $1 - vmid
# Outputs:
#   Progress via info(); errors via die().
#######################################
cmd_umount() {
  local vmid=${1:?usage: $PROG umount <vmid>}
  need_root
  umount_rootfs "$vmid"
  info "rootfs unmounted for CT $vmid"
}

#######################################
# Retire the legacy pvect-ostree plugin storage (storeid 'ostree').
#
# The storage must never be re-created automatically: rootdir volumes now come
# from the resolved standard storages and vztmpl from the resolved vztmpl
# target. Refuses while volumes still live on the old storeid (migrate them
# first).
# Globals:
#   None
# Outputs:
#   Progress via info(); errors via die().
# Returns:
#   Exits 1 on failure or refusal.
#######################################
cmd_retire() {
  need_root
  command -v pvesm >/dev/null 2>&1 || die "pvesm not found"
  pvesm status 2>/dev/null | awk '{print $1}' | grep -qx "ostree" \
    || { info "storage 'ostree' already absent"; return 0; }
  local n
  n=$(pvesm list ostree 2>/dev/null | awk 'NR > 1' | wc -l)
  [[ $n -eq 0 ]] || die "storage 'ostree' still holds $n volume(s); migrate first"
  pvesm remove ostree 2>/dev/null \
    || die "pvesm remove ostree failed"
  info "storage 'ostree' retired (plugin type pvect-ostree stays installed for migration reads)"
}

#######################################
# Re-establish the rootfs mount for every managed container after a reboot.
# Globals:
#   REG_DIR
# Outputs:
#   Progress via info(); warnings via warn().
# Returns:
#   0 if all mounts succeed, 1 if any failed.
#######################################
cmd_remount_all() {
  need_root
  need_tools
  pin_userns
  local f vmid rc=0
  shopt -s nullglob
  for f in "$REG_DIR"/*.env; do
    vmid=$(basename "$f" .env)
    if [[ -f "/etc/pve/lxc/$vmid.conf" ]]; then
      if cmd_mount "$vmid"; then
        info "remounted CT $vmid"
      else
        warn "failed to remount CT $vmid"
        rc=1
      fi
    fi
  done
  return $rc
}

#######################################
# List every managed container with its stateroot, status and image.
# Globals:
#   REG_DIR
# Outputs:
#   A table on stdout.
#######################################
cmd_list() {
  local f vmid
  shopt -s nullglob
  printf '%-8s %-14s %-8s %s\n' VMID STATEROOT STATUS IMAGE
  for f in "$REG_DIR"/*.env; do
    # shellcheck source=/dev/null
    (
      . "$f"
      local st
      # VMID/STATEROOT/IMGREF come from the sourced .env above.
      # shellcheck disable=SC2153
      st=$(pct status "$VMID" 2>/dev/null | awk '{print $2}')
      printf '%-8s %-14s %-8s %s\n' \
        "$VMID" "$STATEROOT" "${st:-none}" "$IMGREF"
    )
  done
}

#######################################
# Stop, unmount, destroy and de-register a container, then purge the ostree
# stateroot (branch ref + deployment tree): a destroy that left the sysroot
# half-populated made renames a manual sweep. The per-CT sysroot lives inside
# the rootfs volume, so it goes away with the volume itself; pct destroy
# --purge frees the rootfs and the writable-layer mp volumes.
# Globals:
#   PROG, STATE_DIR
# Arguments:
#   $1 - vmid
# Outputs:
#   Progress via info(); errors via die().
#######################################
cmd_destroy() {
  local vmid=${1:?usage: $PROG destroy <vmid>}
  need_root
  need_tools
  local stateroot=ct$vmid
  # The registry may carry a renamed stateroot (official guests 12x/13x).
  if [[ -r $(reg_file "$vmid") ]]; then
    reg_load "$vmid"
    # STATEROOT comes from the sourced registry .env above.
    # shellcheck disable=SC2153
    stateroot=$STATEROOT
  fi
  pct stop "$vmid" 2>/dev/null
  umount_rootfs "$vmid"
  # Purge the stateroot BEFORE the volume (and the per-CT sysroot inside it)
  # goes away. The legacy host sysroot is cleaned too while it still exists.
  local sysroot legacy_root=/var/lib/pvect-ostree/sysroot
  if [[ -d $legacy_root/ostree/deploy/$stateroot ]]; then
    sysroot=$legacy_root
  elif [[ -d "$(ct_sysroot "$vmid")/ostree/deploy/$stateroot" ]]; then
    sysroot=$(ct_sysroot "$vmid")
  fi
  if [[ -n ${sysroot:-} ]]; then
    ostree refs --repo="$sysroot/ostree/repo" --delete "ostree/$stateroot" \
      2>/dev/null || true
    rm -rf "$sysroot/ostree/deploy/$stateroot"
  fi
  pct destroy "$vmid" --purge 2>/dev/null
  rm -f "$(reg_file "$vmid")"
  rm -rf "${STATE_DIR:?}/$vmid" "${STATE_DIR:?}/$vmid.env"
  info "CT $vmid destroyed (stateroot $stateroot purged)"
}

#######################################
# Parse --name (and, for publish, --timer and --no-test) after a positional
# compose file.
# Globals:
#   STACK, WITH_TIMER, NO_TEST (set)
# Arguments:
#   $@ - the remaining arguments
#######################################
parse_stack_args() {
  local want_timer=$1
  shift
  STACK=""
  WITH_TIMER=0
  NO_TEST=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name)
        STACK=$2
        shift 2
        ;;
      --timer)
        [ "$want_timer" -eq 1 ] || die "unknown option: --timer"
        WITH_TIMER=1
        shift
        ;;
      --no-test)
        [ "$want_timer" -eq 1 ] || die "unknown option: --no-test"
        NO_TEST=1
        shift
        ;;
      *) die "unknown option: $1" ;;
    esac
  done
  [[ $STACK =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ || -z $STACK ]] \
    || die "invalid stack name: $STACK"
}

#######################################
# Build a compose stack into a bootc image (smoke-gated) and record the
# compose source the rebuilt stack derives from.
# Globals:
#   COMPOSE_DIR, CONF (sourced)
# Arguments:
#   $1 - compose file
#   $2+ - [--name N]
# Outputs:
#   Progress via info(); the image reference on stdout.
# Returns:
#   Exits 1 (via compose2bootc) when the smoke test fails.
#######################################
cmd_build() {
  local compose=${1:?usage: $PROG build <compose.yml> [--name N] [--no-test]}
  shift
  need_root
  need_compose
  parse_stack_args 0 "$@"
  [[ -n $STACK ]] || STACK=$(basename "$(cd "$(dirname "$compose")" && pwd)")
  [[ -f $compose ]] || die "compose file not found: $compose"

  local imgref="localhost/$STACK:latest"
  local no_test_flags=()
  [[ $NO_TEST -eq 1 ]] && no_test_flags=(--no-test)
  # stdout stays reserved for the image reference; narration goes to stderr.
  echo "$PROG: building stack $STACK (compose2bootc: transpile, build, lint, smoke test)" >&2
  compose2bootc convert "$compose" --name "$STACK" --registry "$imgref" --keep \
    "${no_test_flags[@]}" \
    >/dev/null \
    || die "compose2bootc build failed (smoke test not passed; image not published)"

  mkdir -p "$COMPOSE_DIR/$STACK"
  [[ $compose == "$COMPOSE_DIR/$STACK/docker-compose.yml" ]] \
    || cp "$compose" "$COMPOSE_DIR/$STACK/docker-compose.yml"
  # stdout stays clean (callers capture the image reference); tell the user on stderr.
  echo "$PROG: BUILD OK: $imgref (compose source: $COMPOSE_DIR/$STACK/docker-compose.yml)" >&2
  echo "$imgref"
}

#######################################
# Publish a compose stack as an LXC seed template on the PVE btrfs storage,
# uploaded through the storage API: build (smoke-gated), then
# $TEMPLATE_STORAGE:vztmpl/<stack>.tar.gz. The payload + relocation sidecars
# live beside the recorded compose source ($COMPOSE_DIR/<stack>/).
# --no-test builds without the healthcheck smoke gate: required for stacks
# that hold a single Forgejo connection (a real runner cannot share it with
# a smoke-test runner, which would register itself as a new runner).
# `pct create <vmid> $TEMPLATE_STORAGE:vztmpl/<stack>.tar.gz` is the standard
# entry point.
# Globals:
#   COMPOSE_DIR, TEMPLATE_STORAGE
# Arguments:
#   $1 - compose file
#   $2+ - [--name N] [--timer]
# Outputs:
#   Progress via info().
#######################################
cmd_publish() {
  local compose=${1:?usage: $PROG publish <compose.yml> [--name N] [--timer]}
  shift
  need_root
  parse_stack_args 1 "$@"
  local imgref
  if [[ -n $STACK ]]; then
    imgref=$(cmd_build "$compose" --name "$STACK") || exit 1
  else
    imgref=$(cmd_build "$compose") || exit 1
  fi
  # Re-derive the stack name when only the compose file was given: the build
  # record and the payload must carry the same name.
  [[ -n $STACK ]] || STACK=$(basename "$(cd "$(dirname "$compose")" && pwd)")

  if [[ $WITH_TIMER -eq 1 ]]; then
    info "installing the 7-day rebuild timer for $STACK"
    compose2bootc install-timer "$compose" --name "$STACK" || \
      warn "could not install the rebuild timer"
  fi

  local tmp
  tmp=$(mktemp -d)
  mkdir -p "$tmp/pvect-ostree" "$tmp/etc" "$COMPOSE_DIR/$STACK"
  cat >"$tmp/pvect-ostree/payload.env" <<EOF
STACK=$STACK
IMGREF=$imgref
COMPOSE=$COMPOSE_DIR/$STACK/docker-compose.yml
EOF
  # /etc/os-release lets the standard pct create path run its OS detection;
  # it must name a distribution PVE::LXC::Setup knows (Debian) — adopt
  # afterwards rewrites the config to the pvect-ostree posture (ostype: unmanaged).
  cat >"$tmp/etc/os-release" <<'EOF'
PRETTY_NAME="DaemonCores bootc compose stack (seed)"
NAME="Debian GNU/Linux"
ID=debian
VERSION_ID="12"
VERSION_CODENAME=bookworm
EOF
  # PVE::LXC::Setup::Debian reads /etc/debian_version next.
  cat >"$tmp/etc/debian_version" <<'EOF'
12/bookworm
EOF
  tar -czf "$tmp/$STACK.tar.gz" -C "$tmp" pvect-ostree etc \
    || die "seed template tar failed"
  if [[ -z $TEMPLATE_STORAGE ]]; then
    die "no storage with 'content vztmpl' found in $STORAGE_CFG (set TEMPLATE_STORAGE in $CONF)"
  fi
  pvesh create "/nodes/$(hostname)/storage/$TEMPLATE_STORAGE/upload" \
    -filename "$tmp/$STACK.tar.gz" -content vztmpl \
    || die "template upload to $TEMPLATE_STORAGE:vztmpl failed"
  cp "$tmp/pvect-ostree/payload.env" "$COMPOSE_DIR/$STACK/$STACK.payload.env"
  # Keep the relocation report beside the compose source when compose2bootc
  # wrote one.
  cp "/var/lib/compose2bootc/$STACK/context/RELOCATIONS.txt" \
    "$COMPOSE_DIR/$STACK/$STACK.RELOCATIONS.txt" 2>/dev/null \
    || warn "no RELOCATIONS.txt found (kept report absent)"
  rm -rf "$tmp"
  info "published template: pct create <vmid> $TEMPLATE_STORAGE:vztmpl/$STACK.tar.gz"
}

#######################################
# List the published compose templates with their image and compose source.
# Globals:
#   COMPOSE_DIR
# Arguments:
#   $1 - optional stack name filter
#######################################
cmd_templates() {
  need_root
  local f stack
  printf '%-16s %-28s %s\n' STACK IMAGE COMPOSE
  shopt -s nullglob
  for f in "$COMPOSE_DIR"/*/*.payload.env; do
    # shellcheck source=/dev/null
    . "$f"
    # STACK/IMGREF/COMPOSE come from the sourced payload above.
    # shellcheck disable=SC2153
    [[ -z ${1:-} || $STACK == "$1" ]] || continue
    printf '%-16s %-28s %s\n' "$STACK" "$IMGREF" "$COMPOSE"
  done
}

#######################################
# Rebuild a CT from its recorded compose source and update it, keeping the
# previous deployment for rollback.
# Globals:
#   REG_DIR, COMPOSE_DIR
# Arguments:
#   $1 - vmid
#######################################
cmd_refresh() {
  local vmid=${1:?usage: $PROG refresh <vmid>}
  need_root
  reg_load "$vmid"
  local compose=$COMPOSE # COMPOSE comes from the sourced registry entry.
  [[ -n ${compose:-} && -f $compose ]] \
    || die "CT $vmid has no recorded compose source ($compose)"
  local stack=${IMGREF#localhost/}
  stack=${stack%%:*}
  info "rebuilding CT $vmid from $compose"
  local imgref
  imgref=$(cmd_build "$compose" --name "$stack") || exit 1
  reg_write "$vmid" "$STATEROOT" "$imgref" "$compose"
  cmd_update "$vmid" "$imgref"
}

#######################################
# Apply the pvect-ostree posture to a CT config (standalone entry point).
# Globals:
#   PROG
# Arguments:
#   $1 - vmid
#######################################
cmd_normalise() {
  local vmid=${1:?usage: $PROG normalise <vmid>}
  need_root
  normalise_conf "$vmid"
  info "CT $vmid config normalised"
}

#######################################
# Wire a CT created from a published seed template into the pvect-ostree
# registry: read the payload, deploy the image, mount the composefs view.
# Globals:
#   REG_DIR, TEMPLATE_DIR
# Arguments:
#   $1 - vmid
#######################################
cmd_adopt() {
  local vmid=${1:?usage: $PROG adopt <vmid>}
  need_root
  need_tools
  [[ -f "/etc/pve/lxc/$vmid.conf" ]] || die "CT $vmid does not exist"
  local root
  root=$(subvol_path "$vmid")
  local payload="$root/pvect-ostree/payload.env"
  [[ -r $payload ]] || die "no seed payload for CT $vmid at $payload"

  local stack imgref compose
  # shellcheck source=/dev/null
  . "$payload"
  # The seed payload defines the UPPER_CASE forms written by cmd_publish;
  # map them to the lower-case locals the adopt flow expects.
  stack=${STACK:-$stack}
  imgref=${IMGREF:-$imgref}
  compose=${COMPOSE:-$compose}
  info "adopting CT $vmid from seed template (stack ${stack:-?}, image $imgref)"
  cmd_deploy "$imgref" "ct$vmid" "$(ct_sysroot "$vmid")"
  reg_write "$vmid" "ct$vmid" "$imgref" "${compose:-}"
  normalise_conf "$vmid"
  mount_rootfs "$vmid"
  info "CT $vmid adopted; start it from the Web UI or: pct start $vmid"
}

#######################################
# Migrate a legacy CT's writable-layer host-path binds to PVE mp volumes
# (storage API allocated on ROOTFS_STORAGE), copying the data first.
#
# Per-CT, stop-then-copy discipline: the CT is stopped, each host-path mp
# (etc/var/bootc/data/...) is copied byte-for-byte into a freshly allocated
# rootdir volume, the conf line is swapped, then the CT is started back. The
# source trees are PRESERVED (cleanup is an explicit, separate decision).
# Hard gate: this refuses every production vmid unless PVECT_MIGRATE_GO=1 is
# exported — the prototype window runs on 999x test CTs only.
# Globals:
#   PROG, ROOTFS_STORAGE
# Arguments:
#   $1 - vmid
# Outputs:
#   Progress via info(); errors via die().
#######################################
cmd_migrate() {
  local vmid=${1:?usage: $PROG migrate <vmid>}
  need_root
  need_tools
  local conf="/etc/pve/lxc/$1.conf"
  [[ -f $conf ]] || die "CT config not found: $conf"
  if ! [[ $vmid =~ ^99[0-9][0-9]$ ]]; then
    [[ ${PVECT_MIGRATE_GO:-0} == 1 ]] \
      || die "refusing production vmid $vmid: set PVECT_MIGRATE_GO=1 for the cutover"
  fi

  local was_running=0
  [[ "$(pct status "$vmid" 2>/dev/null)" == *running* ]] && was_running=1
  [[ $was_running -eq 1 ]] && {
    info "stopping CT $vmid"
    pct shutdown "$vmid" --timeout 120 || die "pct shutdown $vmid failed"
  }

  # Collect the legacy host-path mp lines (slot, source dir, ct mountpoint).
  python3 - "$conf" <<'PY' >/tmp/pvect-migrate-$vmid.tsv || die "conf parse failed"
import re, sys
for line in open(sys.argv[1]):
    m = re.match(r"^(mp\d+):\s*(\S+?)(?:,|$)", line)
    if not m:
        continue
    slot, first = m.group(1), m.group(2)
    mm = re.search(r",mp=(\S+?)(?:,|$)", line)
    if mm:
        target = mm.group(1)
    else:
        target = first  # legacy mp without mp= (PVE 5.x style)
    if first.startswith("/"):
        print(f"{slot}\t{first}\t{target}")
PY

  local slot src target volid volpath size next idx mp_st
  while IFS=$'\t' read -r slot src target; do
    [[ -n $slot && -n $src && -n $target ]] || continue
    info "migrating $slot: $src -> $target"
    [[ -d $src ]] || { warn "source missing: $src (skipped)"; continue; }
    [[ $target == /* ]] || { warn "weird mountpoint $target (skipped)"; continue; }
    mp_st=$(volume_storage rootdir "" "$ROOTFS_STORAGE" "$slot")
    # Size: du + 2G margin, GB, minimum 4 (1 G would be too tight for /etc
    # trees that grew beyond the seed).
    size=$(du -sk "$src" 2>/dev/null | awk '{print $1}')
    (( size = (size + 2097152) / 1048576 ))
    (( size < 4 )) && size=4
    # Find the next free disk index across the storage for this vmid (disk-0
    # is the rootfs, always present in the listing).
    next=$(pvesm list "$mp_st" 2>/dev/null \
      | grep "^${mp_st}:${vmid}/subvol-${vmid}-disk-" \
      | grep -oE 'disk-[0-9]+' | sed 's/disk-//' | sort -n | tail -1)
    next=${next:-0}
    idx=$(( next + 1 ))
    volid=$(pvesm alloc "$mp_st" "$vmid" \
      "subvol-$vmid-disk-$idx.subvol" "${size}G") \
      || die "allocation of the $slot volume ($size G) failed"
    volpath=$(pvesm path "$volid") || die "cannot resolve $volid"
    info "copying $src -> $volpath ($size G)"
    mkdir -p "$volpath"
    rsync -aHAX --numeric-ids --delete "$src/" "$volpath/" \
      || die "copy of $slot failed"
    info "swapping conf: $slot -> $volid"
    sed -i "s~^$slot: .*~$slot: $volid,mp=$target~" "$conf" \
      || die "conf swap failed for $slot"
  done </tmp/pvect-migrate-$vmid.tsv
  rm -f /tmp/pvect-migrate-$vmid.tsv

  normalise_conf "$vmid"
  [[ $was_running -eq 1 ]] && pct start "$vmid"
  info "CT $vmid migrated to volume-backed layers (source trees preserved pre-cleanup)"
}

#######################################
# Print the rootfs subvol path PVE allocated for a CT (plugin helper).
# Globals:
#   STORAGE
# Arguments:
#   $1 - vmid
# Outputs:
#   Subvol path on stdout.
#######################################
cmd_subvol_path() {
  local vmid=${1:?usage: $PROG subvol-path <vmid>}
  need_root
  subvol_path "$vmid"
}

#######################################
# Print the usage synopsis extracted from this file's header.
# Arguments:
#   $1 - exit code (default: 0)
# Outputs:
#   Usage text on stdout.
# Returns:
#   Exits with the given code.
#######################################
usage() {
  sed -n '3,20p' "$0" | sed 's/^# \{0,1\}//'
  exit "${1:-0}"
}

#######################################
# Dispatch to the requested subcommand.
# Globals:
#   PROG
# Arguments:
#   $1  - subcommand
#   $2+ - subcommand arguments
# Outputs:
#   Depends on the subcommand.
# Returns:
#   Exits 1 on an unknown command.
#######################################
main() {
  local cmd=${1:-}
  [[ -n $cmd ]] || usage 1
  shift
  case "$cmd" in
    -h | --help | help) usage 0 ;;
  esac
  # Explicit conf/CLI-set storages are honoured; the empty ones are resolved
  # from the node's own storage configuration before any subcommand runs.
  resolve_default_storages
  case "$cmd" in
    deploy) cmd_deploy "$@" ;;
    create) cmd_create "$@" ;;
    update) cmd_update "$@" ;;
    rollback) cmd_rollback "$@" ;;
    mount) cmd_mount "$@" ;;
    umount) cmd_umount "$@" ;;
    normalise) cmd_normalise "$@" ;;
    remount-all) cmd_remount_all "$@" ;;
    seed) cmd_seed "$@" ;;
    list) cmd_list "$@" ;;
    destroy) cmd_destroy "$@" ;;
    migrate) cmd_migrate "$@" ;;
    retire) cmd_retire "$@" ;;
    build) cmd_build "$@" ;;
    publish) cmd_publish "$@" ;;
    templates) cmd_templates "$@" ;;
    refresh) cmd_refresh "$@" ;;
    adopt) cmd_adopt "$@" ;;
    subvol-path) cmd_subvol_path "$@" ;;
    -h | --help | help) usage 0 ;;
    *) die "unknown command '$cmd' (try: $PROG --help)" ;;
  esac
}

# Run only when executed directly: sourcing the file (tests) loads the
# functions without dispatching.
if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi
